{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-adaptor alignment task handoff 1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(C[0-9]{2}|T[0-9]{2}|G[0-9]{2})$"
    },
    "status": {
      "enum": [
        "complete",
        "blocked",
        "needs_rework"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "base_head": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "head_sha": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[0-9a-f]{40}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "evidence",
          "note"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "evidence",
          "note"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "os": {
            "type": "string",
            "minLength": 1
          },
          "go_version": {
            "type": "string"
          },
          "cli_version": {
            "type": "string"
          },
          "head_sha": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^[0-9a-f]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked"
            ]
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "executed_test_count": {
            "type": "integer",
            "minimum": 0
          },
          "skipped_required_tests": {
            "type": "integer",
            "minimum": 0
          },
          "permitted_skips": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "log_path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "command",
          "cwd",
          "environment",
          "os",
          "go_version",
          "cli_version",
          "head_sha",
          "status",
          "exit_code",
          "executed_test_count",
          "skipped_required_tests",
          "permitted_skips",
          "log_path",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "contract",
              "documentation",
              "evidence",
              "fixture",
              "report"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "kind",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^W(0[1-9]|1[0-3])-R[0-9]{2}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "owner_task": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(C[0-9]{2}|T[0-9]{2}|G[0-9]{2})$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "severity",
          "requirement_ids",
          "owner_task",
          "summary",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "remaining_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "documentation": {
      "type": "object",
      "properties": {
        "fragment": {
          "type": "string",
          "minLength": 1
        },
        "ready": {
          "type": "boolean"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "centralized_by_gate": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(C[0-9]{2}|T[0-9]{2}|G[0-9]{2})$"
        }
      },
      "required": [
        "fragment",
        "ready",
        "targets",
        "centralized_by_gate"
      ],
      "additionalProperties": false
    },
    "live_authorization": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "build_tag": {
              "type": "string",
              "minLength": 1
            },
            "environment_gate": {
              "const": "AGENT_ADAPTOR_LIVE_CONFORMANCE=1"
            },
            "isolated_profile": {
              "type": "string",
              "minLength": 1
            },
            "isolated_workspace": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "reference",
            "provider",
            "build_tag",
            "environment_gate",
            "isolated_profile",
            "isolated_workspace"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "gate_details": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "accepted_tasks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(C[0-9]{2}|T[0-9]{2}|G[0-9]{2})$"
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "tested_head": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[0-9a-f]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "next_batch_base": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[0-9a-f]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "contracts_manifest": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "release_readiness": {
              "type": "boolean"
            },
            "release_authorized": {
              "const": false
            }
          },
          "required": [
            "accepted_tasks",
            "tested_head",
            "next_batch_base",
            "contracts_manifest",
            "release_readiness",
            "release_authorized"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "status",
    "attempt",
    "base_head",
    "head_sha",
    "commits",
    "changed_files",
    "acceptance",
    "requirements",
    "checks",
    "artifacts",
    "findings",
    "remaining_items",
    "documentation",
    "live_authorization",
    "gate_details",
    "summary"
  ],
  "additionalProperties": false
}
