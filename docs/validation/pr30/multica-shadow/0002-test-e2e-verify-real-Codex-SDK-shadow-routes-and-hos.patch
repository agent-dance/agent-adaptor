+import "./env";
+
+import { createHash, randomUUID } from "node:crypto";
+import { createServer, type ServerResponse } from "node:http";
+import { readFile, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { expect, test, type Page, type TestInfo } from "@playwright/test";
+import { TestApiClient } from "./fixtures";
+import {
+  deliveredReceipt, requireAfterDone, requireExactTaskIDs, requireSuccess,
+  sdkAuditRunIDs, requireSDKCleanupBeforeNext, type ShadowTask,
+} from "./agent-adaptor-shadow.evidence";
+import { appendShadowReport } from "./agent-adaptor-shadow.report";
+import { inspectDevelopmentWorkspace } from "./agent-adaptor-shadow.acceptance";
+
+// Discovery and the ordinary suite never authenticate or resolve a user CLI.
+const enabled = process.env.MULTICA_RUN_AGENT_ADAPTOR_SHADOW === "1";
+const phase = process.env.MULTICA_SHADOW_BACKEND;
+const timeout = Number(process.env.MULTICA_SHADOW_TIMEOUT_MS || 480_000);
+type Json = Record<string, any>;
+type Gate = { url: string; wait: () => Promise<void>; release: () => void; close: () => Promise<void>; arrival?: string };
+
+function required(name: string): string {
+  const value = process.env[name];
+  if (!value) throw new Error(`Explicit ${name} is required for a real-agent test`);
+  return value;
+}
+function localURL(value: string): string {
+  const url = new URL(value);
+  if (!["127.0.0.1", "localhost", "[::1]"].includes(url.hostname)) throw new Error("Shadow acceptance requires a local managed server");
+  return value.replace(/\/$/, "");
+}
+function scrub(value: unknown, secrets: string[]): unknown {
+  if (typeof value === "string") return secrets.reduce((text, secret) => secret ? text.replaceAll(secret, "[REDACTED]") : text, value);
+  if (Array.isArray(value)) return value.map((item) => scrub(item, secrets));
+  if (value && typeof value === "object") return Object.fromEntries(Object.entries(value).map(([key, item]) => [key, scrub(item, secrets)]));
+  return value;
+}
+
+// A real provider shell must perform the HTTP request before wait resolves.
+// Release is controlled by the browser test, never by a guessed delay.
+async function gate(): Promise<Gate> {
+  const key = randomUUID();
+  const pending = new Set<ServerResponse>();
+  let arrived!: () => void;
+  const reached = new Promise<void>((done) => { arrived = done; });
+  let released = false;
+  const server = createServer((request, response) => {
+    if (request.method !== "GET" || request.url !== `/${key}`) { response.writeHead(404).end(); return; }
+    if (!result.arrival) { result.arrival = new Date().toISOString(); arrived(); }
+    if (released) { response.end("HOST_RELEASED"); return; }
+    pending.add(response);
+    response.on("close", () => pending.delete(response));
+  });
+  await new Promise<void>((done, reject) => { server.once("error", reject); server.listen(0, "127.0.0.1", done); });
+  const address = server.address();
+  if (!address || typeof address === "string") throw new Error("Gate has no TCP address");
+  const result: Gate = {
+    url: `http://127.0.0.1:${address.port}/${key}`,
+    wait: () => Promise.race([reached, new Promise<never>((_, reject) => { const timer = setTimeout(() => reject(new Error("Real provider shell did not reach gate")), timeout); timer.unref(); })]),
+    release: () => { released = true; for (const response of pending) response.end("HOST_RELEASED"); pending.clear(); },
+    close: async () => { result.release(); server.closeAllConnections(); await new Promise<void>((done) => server.close(() => done())); },
+  };
+  return result;
+}
+function hold(g: Gate): string {
+  return `Before final response, execute this exact foreground shell command and wait for its response (do not background it): python3 -c 'import urllib.request; print(urllib.request.urlopen("${g.url}", timeout=420).read().decode())'. Do not run sleep, inspect environment/auth, or bypass the host gate.`;
+}
+const development = `Implement shadow_math.py with a pure add(a,b) function returning a+b. This narrow fixture file may contain only an optional module docstring and def add(a,b): with an optional function docstring and a return of pure arithmetic; no imports, annotations, decorators, defaults, global assignments, top-level execution or other definitions. Implement test_shadow_math.py using unittest with at least two actually executed positive and negative addition tests, without skips or expected failures. Run python3 -m unittest -v test_shadow_math.py and then python3 -c 'from shadow_math import add; assert add(-2,5)==3; print("SHADOW_TEST_OK")'. Keep changes inside your provided task workspace. Report the file names and actual test result. The host will independently check actual source and run both fixed acceptance cases and your generated unittest; printing a marker does not establish success. Do not inspect credentials or change Multica itself.`;
+
+class Harness {
+  api = new TestApiClient();
+  base = "";
+  workspace!: { id: string; slug: string };
+  agent!: Json;
+  createdAgents: string[] = [];
+  createdChats: string[] = [];
+  issues: Json[] = [];
+  evidence: Json = { started: new Date().toISOString(), checks: [], apiSnapshots: [], uiScreenshots: [], gates: [], tasks: [] };
+  secrets: string[] = [];
+  userID = "";
+  daemonStart = 0;
+  constructor(readonly page: Page, readonly info: TestInfo) {}
+  async init() {
+    if (phase !== "native" && phase !== "agent-adaptor") throw new Error("MULTICA_SHADOW_BACKEND must explicitly name native or agent-adaptor");
+    this.base = localURL(required("NEXT_PUBLIC_API_URL"));
+    localURL(required("PLAYWRIGHT_BASE_URL"));
+    const email = required("MULTICA_SHADOW_EMAIL");
+    if (!email.endsWith("@localhost")) throw new Error("Use the isolated localhost test account");
+    required("MULTICA_SHADOW_MODEL"); required("MULTICA_SHADOW_EFFORT");
+    required("MULTICA_SHADOW_REPORT"); required("MULTICA_SHADOW_RUN_ID");
+    localURL(required("DATABASE_URL"));
+    const log = required("MULTICA_SHADOW_DAEMON_LOG");
+    this.daemonStart = (await readFile(log)).length;
+    const login = await this.api.login(email, "PR30 Shadow");
+    this.userID = login.user?.id;
+    if (!this.userID) throw new Error("Isolated login returned no user identity");
+    const slug = required("MULTICA_SHADOW_WORKSPACE_SLUG");
+    this.workspace = await this.api.ensureWorkspace("PR30 SDK Shadow", slug);
+    expect(this.workspace.slug, "Never fall back to an unrelated workspace").toBe(slug);
+    this.api.setWorkspaceId(this.workspace.id); this.api.setWorkspaceSlug(slug);
+    await this.api.markUserOnboarded();
+    const token = this.api.getToken();
+    if (!token) throw new Error("Isolated login returned no token");
+    this.secrets = [token, process.env.OPENAI_API_KEY || ""];
+    await this.page.addInitScript((auth) => { localStorage.setItem("multica_token", auth); localStorage.setItem("multica:chat:isOpen", "false"); }, token);
+    await this.page.setViewportSize({ width: 1440, height: 1000 });
+    this.agent = await this.request("/api/agents", { method: "POST", body: {
+      name: `PR30 ${phase} ${randomUUID().slice(0, 8)}`, runtime_id: required("MULTICA_SHADOW_RUNTIME_ID"),
+      model: required("MULTICA_SHADOW_MODEL"), thinking_level: required("MULTICA_SHADOW_EFFORT"),
+      max_concurrent_tasks: 1, visibility: "private", description: "Isolated opt-in real-agent acceptance",
+      instructions: "Follow the actual human task. Use tools to perform requested code and tests. Never claim a task or test succeeded without running it. Do not read auth files or dump environment variables.",
+    } });
+    this.createdAgents.push(this.agent.id);
+    this.evidence.configuration = { backendRequested: phase, model: process.env.MULTICA_SHADOW_MODEL, effort: process.env.MULTICA_SHADOW_EFFORT, workspace: this.workspace, agent: { id: this.agent.id, name: this.agent.name, runtime_id: this.agent.runtime_id }, source: "actual-local-Multica-server-daemon" };
+  }
+  async request(path: string, options: { method?: string; body?: unknown } = {}): Promise<any> {
