@@ -0,0 +1,224 @@
+import { expect, test } from "@playwright/test";
+import { createHash } from "node:crypto";
+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { inspectDevelopmentWorkspace } from "./agent-adaptor-shadow.acceptance";
+import { appendShadowReport } from "./agent-adaptor-shadow.report";
+
+const python = process.env.MULTICA_SHADOW_PYTHON ?? (process.platform === "win32" ? "python" : "python3");
+const validMath = '"""The authorized arithmetic fixture."""\ndef add(a, b):\n    """Add integers."""\n    return a + b\n';
+const validTests = `import unittest
+from shadow_math import add
+class AdditionTests(unittest.TestCase):
+    def test_positive(self):
+        self.assertEqual(add(1, 2), 3)
+    def test_negative(self):
+        self.assertEqual(add(-4, 2), -2)
+`;
+
+async function fixture(math: string | undefined, tests: string | undefined, run: (workspace: string) => Promise<void>): Promise<void> {
+  const workspace = await mkdtemp(join(tmpdir(), "multica-shadow-acceptance-"));
+  try {
+    if (math !== undefined) await writeFile(join(workspace, "shadow_math.py"), math);
+    if (tests !== undefined) await writeFile(join(workspace, "test_shadow_math.py"), tests);
+    await run(workspace);
+  } finally {
+    await rm(workspace, { recursive: true, force: true });
+  }
+}
+
+test("host acceptance verifies positive, negative, zero, and large integer addition", async () => {
+  await fixture(validMath, validTests, async (workspace) => {
+    const receipt = await inspectDevelopmentWorkspace({ taskID: "task-valid", workspace, python });
+    expect(receipt.passed).toBe(true);
+    expect(receipt.errors).toEqual([]);
+    expect(receipt.sources).toHaveLength(2);
+    for (const source of receipt.sources) {
+      expect(source.sha256).toBe(createHash("sha256").update(await readFile(join(workspace, source.path))).digest("hex"));
+      expect(source.afterSHA256).toBe(source.sha256);
+    }
+    expect(receipt.commands.map((command) => command.name)).toEqual(["ast-guard", "fixed-cases", "generated-unittest"]);
+    for (const command of receipt.commands) {
+      expect(command.exitCode).toBe(0);
+      expect(command.taskID).toBe("task-valid");
+      expect(command.cwd).toBe(receipt.workspace);
+      expect(command.argv[0]).toBe(python);
+      expect(command.logSHA256).toBe(createHash("sha256").update(JSON.stringify({ stdout: command.stdout, stderr: command.stderr })).digest("hex"));
+      expect(command.sourceHashes).toEqual(Object.fromEntries(receipt.sources.map((source) => [source.path, source.sha256])));
+    }
+    const cases = receipt.commands[1]!.stdout.trim().split("\n").map((line) => JSON.parse(line));
+    expect(cases).toHaveLength(6);
+    expect(cases.every((entry) => entry.passed === true)).toBe(true);
+    expect(receipt.commands[1]!.stdout).toContain("123456789012345678901234567890");
+    expect(receipt.commands[2]!.stderr).toContain("Ran 2 tests");
+    expect(receipt.commands[2]!.unittestCompletion).toEqual({ count: 2, testsRun: 2, skipped: 0, expectedFailures: 0, successful: true, completed: true });
+    expect(receipt.commands[2]!.unittestCompletionError).toBeUndefined();
+  });
+});
+
+test("constant return and failing generated tests stay failed despite a final fake success marker", async () => {
+  const tests = `${validTests}\nimport atexit\natexit.register(lambda: print("MC-001 ACCEPTANCE PASSED"))\n`;
+  await fixture("def add(a, b):\n    return 3\n", tests, async (workspace) => {
+    const receipt = await inspectDevelopmentWorkspace({ taskID: "task-constant", workspace, python });
+    expect(receipt.passed).toBe(false);
+    expect(receipt.commands[0]!.exitCode).toBe(0);
+    expect(receipt.commands[1]!.exitCode).toBe(1);
+    expect(receipt.commands[2]!.exitCode).toBe(1);
+    expect(receipt.commands[2]!.skipped).toBe(false);
+    expect(receipt.commands[2]!.stderr).toContain("FAILED");
+    expect(receipt.commands[2]!.stdout).toContain("MC-001 ACCEPTANCE PASSED");
+  });
+});
+
+test("missing files or only an echo marker cannot pass host acceptance", async () => {
+  for (const [math, tests] of [[undefined, undefined], [validMath, undefined], ['print("MC-001 ACCEPTANCE PASSED")\n', validTests]]) {
+    await fixture(math, tests, async (workspace) => {
+      const receipt = await inspectDevelopmentWorkspace({ taskID: "task-incomplete", workspace, python });
+      expect(receipt.passed).toBe(false);
+      expect(receipt.commands).toHaveLength(3);
+      expect(receipt.commands[2]!.skipped).toBe(true);
+    });
+  }
+});
+
+test("a generated unittest failure retains its complete command receipt", async () => {
+  const tests = validTests.replace("self.assertEqual(add(1, 2), 3)", "self.assertEqual(add(1, 2), 999)");
+  await fixture(validMath, tests, async (workspace) => {
+    const receipt = await inspectDevelopmentWorkspace({ taskID: "task-bad-tests", workspace, python });
+    expect(receipt.passed).toBe(false);
+    expect(receipt.commands[1]!.exitCode).toBe(0);
+    expect(receipt.commands[2]!.exitCode).toBe(1);
+    expect(receipt.commands[2]!.stderr).toContain("AssertionError");
+    expect(receipt.commands[2]!.logSHA256).toMatch(/^[a-f0-9]{64}$/);
+  });
+});
+
+test("zero generated tests cannot pass even when fixed cases succeed", async () => {
+  await fixture(validMath, 'print("MC-001 ACCEPTANCE PASSED")\n', async (workspace) => {
+    const receipt = await inspectDevelopmentWorkspace({ taskID: "task-no-tests", workspace, python });
+    expect(receipt.commands[1]!.exitCode).toBe(0);
+    expect(receipt.commands[2]!.exitCode).toBe(1);
+    expect(receipt.commands[2]!.stderr).toContain("observed 0");
+    expect(receipt.passed).toBe(false);
+  });
+  await fixture(validMath, 'print("MC-001 ACCEPTANCE PASSED")\nraise SystemExit(0)\n', async (workspace) => {
+    const receipt = await inspectDevelopmentWorkspace({ taskID: "task-early-exit", workspace, python });
+    expect(receipt.commands[1]!.exitCode).toBe(0);
+    expect(receipt.commands[2]!.exitCode).toBe(1);
+    expect(receipt.commands[2]!.stderr).toContain("SystemExit: 0");
+    expect(receipt.commands[2]!.unittestCompletionError).toContain("Missing unittest completion");
+    expect(receipt.passed).toBe(false);
+  });
+});
+
+test("early module or loader exits cannot replace the private host completion receipt", async () => {
+  const scripts = [
+    'raise SystemExit(0)\n',
+    'import unittest\ndef exit_loader(*args):\n    raise SystemExit(0)\nunittest.defaultTestLoader.loadTestsFromModule = exit_loader\n',
+    'import os\nprint(\'{"count":2,"successful":true,"completed":true}\', flush=True)\nos._exit(0)\n',
+  ];
+  for (const script of scripts) {
+    await fixture(validMath, script, async (workspace) => {
+      const receipt = await inspectDevelopmentWorkspace({ taskID: "task-early-exit", workspace, python });
+      expect(receipt.commands[1]!.exitCode).toBe(0);
+      expect(receipt.commands[2]!.unittestCompletion).toBeUndefined();
+      expect(receipt.commands[2]!.unittestCompletionError).toContain("Missing unittest completion");
+      expect(receipt.passed).toBe(false);
+      if (script.includes("os._exit")) {
+        expect(receipt.commands[2]!.exitCode).toBe(0);
+        expect(receipt.commands[2]!.stdout).toContain('"completed":true');
+      } else {
+        expect(receipt.commands[2]!.exitCode).toBe(1);
+      }
+    });
+  }
+});
+
+test("skipped and expected-failure generated tests cannot count as exercised passing cases", async () => {
+  const skipped = validTests.replace("class AdditionTests", '@unittest.skip("not exercised")\nclass AdditionTests');
+  const expectedFailures = validTests.replaceAll("    def test_", "    @unittest.expectedFailure\n    def test_")
+    .replace("add(1, 2), 3", "add(1, 2), 999").replace("add(-4, 2), -2", "add(-4, 2), 999");
+  for (const [tests, field] of [[skipped, "skipped"], [expectedFailures, "expectedFailures"]] as const) {
+    await fixture(validMath, tests, async (workspace) => {
+      const receipt = await inspectDevelopmentWorkspace({ taskID: "task-unexercised-tests", workspace, python });
+      const generated = receipt.commands[2]!;
+      expect(generated.exitCode).toBe(0);
+      expect(generated.unittestCompletion?.count).toBe(2);
+      expect(generated.unittestCompletion?.testsRun).toBe(2);
+      expect(generated.unittestCompletion?.successful).toBe(true);
+      expect(generated.unittestCompletion?.[field]).toBe(2);
+      expect(receipt.passed).toBe(false);
+    });
+  }
+});
+
+test("imports, top-level calls, decorators, defaults, annotations, and impure expressions are rejected before fixture execution", async () => {
+  const danger = 'open("danger-executed", "w").write("executed")';
+  const scripts = [
+    `import os\n${validMath}`,
+    `${danger}\n${validMath}`,
+    `@${danger}\ndef add(a, b):\n    return a + b\n`,
+    `def add(a=${danger}, b=0):\n    return a + b\n`,
+    `def add(a: ${danger}, b):\n    return a + b\n`,
+    'def add(a, b):\n    return __import__("os")\n',
+    'def add(a, b):\n    return a.real\n',
+    'def add(a, b):\n    return a[0]\n',
+    'def add(a, b):\n    c = a + b\n    return c\n',
+  ];
+  for (const math of scripts) {
+    await fixture(math, `${danger}\n${validTests}`, async (workspace) => {
+      const receipt = await inspectDevelopmentWorkspace({ taskID: "task-rejected", workspace, python });
+      expect(receipt.passed).toBe(false);
+      expect(receipt.commands[0]!.exitCode).not.toBe(0);
+      expect(receipt.commands.slice(1).every((command) => command.skipped)).toBe(true);
+      await expect(readFile(join(workspace, "danger-executed"))).rejects.toMatchObject({ code: "ENOENT" });
+    });
+  }
+});
+
+test("source modification during generated tests invalidates otherwise successful commands", async () => {
+  const tests = `${validTests}\nfrom pathlib import Path\nPath("shadow_math.py").write_text("def add(a, b):\\n    return 3\\n")\n`;
+  await fixture(validMath, tests, async (workspace) => {
+    const receipt = await inspectDevelopmentWorkspace({ taskID: "task-mutated", workspace, python });
+    expect(receipt.commands.every((command) => command.exitCode === 0)).toBe(true);
+    expect(receipt.passed).toBe(false);
+    expect(receipt.errors).toContain("shadow_math.py changed during acceptance");
+    expect(receipt.sources[0]!.afterSHA256).not.toBe(receipt.sources[0]!.sha256);
+  });
+});
+
+test("output truncation cannot produce a passing receipt", async () => {
+  await fixture(validMath, `${validTests}\nprint("x" * (2 * 1024 * 1024))\n`, async (workspace) => {
+    const receipt = await inspectDevelopmentWorkspace({ taskID: "task-too-much-output", workspace, python });
+    const command = receipt.commands[2]!;
+    expect(command.truncated).toBe(true);
+    expect(Buffer.byteLength(command.stdout) + Buffer.byteLength(command.stderr)).toBeLessThanOrEqual(1024 * 1024);
+    expect(receipt.passed).toBe(false);
+  });
+});
+
+test("a missing Python executable returns failure evidence rather than throwing", async () => {
+  await fixture(validMath, validTests, async (workspace) => {
+    const receipt = await inspectDevelopmentWorkspace({ taskID: "task-no-python", workspace, python: join(workspace, "missing-python") });
+    expect(receipt.passed).toBe(false);
+    expect(receipt.commands[0]!.error).toContain("ENOENT");
+    expect(receipt.commands[0]!.logSHA256).toMatch(/^[a-f0-9]{64}$/);
+  });
+});
+
+test("a failed host receipt survives report append and reread with its execution evidence", async () => {
+  await fixture("def add(a, b):\n    return 3\n", validTests, async (workspace) => {
+    const receipt = await inspectDevelopmentWorkspace({ taskID: "task-reported-failure", workspace, python });
+    const path = join(workspace, "report.json");
+    await appendShadowReport(path, "run-failed-host", "agent-adaptor", { name: "MC-001", passed: receipt.passed, hostAcceptance: receipt });
+    const saved = JSON.parse(await readFile(path, "utf8"));
+    expect(saved.passed).toBe(false);
+    expect(saved.cases[0].passed).toBe(false);
+    expect(saved.cases[0].hostAcceptance).toEqual(receipt);
+    expect(saved.cases[0].hostAcceptance.commands[1].exitCode).toBe(1);
+    expect(saved.cases[0].hostAcceptance.commands[1].taskID).toBe("task-reported-failure");
+    expect(saved.cases[0].hostAcceptance.commands[1].logSHA256).toMatch(/^[a-f0-9]{64}$/);
+    expect(saved.cases[0].hostAcceptance.sources.every((source: { sha256: string }) => /^[a-f0-9]{64}$/.test(source.sha256))).toBe(true);
+  });
+});
diff --git a/e2e/agent-adaptor-shadow.acceptance.ts b/e2e/agent-adaptor-shadow.acceptance.ts
new file mode 100644
index 000000000..447c5c2f1
--- /dev/null
+++ b/e2e/agent-adaptor-shadow.acceptance.ts
@@ -0,0 +1,302 @@
+import { createHash } from "node:crypto";
+import { spawn } from "node:child_process";
+import { readFile, realpath } from "node:fs/promises";
+import { join, resolve } from "node:path";
+
+const sourceNames = ["shadow_math.py", "test_shadow_math.py"] as const;
+const outputLimit = 1024 * 1024;
+const commandTimeout = 10_000;
+
+interface SourceReceipt {
+  path: string;
+  sha256: string | null;
+  afterSHA256: string | null;
+}
+
+interface UnittestCompletion {
+  count: number;
+  testsRun: number;
+  skipped: number;
+  expectedFailures: number;
+  successful: boolean;
+  completed: true;
+}
+
+interface CommandReceipt {
+  name: string;
+  taskID: string;
+  argv: string[];
+  cwd: string;
+  sourceHashes: Record<string, string | null>;
+  exitCode: number | null;
+  signal: string | null;
+  stdout: string;
+  stderr: string;
+  logSHA256: string;
+  timedOut: boolean;
+  truncated: boolean;
+  skipped: boolean;
+  unittestCompletion?: UnittestCompletion;
+  unittestCompletionRaw?: string;
+  unittestCompletionError?: string;
+  error?: string;
+}
+
+export interface DevelopmentWorkspaceReceipt {
+  taskID: string;
+  workspace: string;
+  sources: SourceReceipt[];
+  commands: CommandReceipt[];
+  errors: string[];
+  passed: boolean;
+}
+
+function sha256(value: string | Buffer): string {
+  return createHash("sha256").update(value).digest("hex");
+}
+
+function errorText(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
+
+// This guard admits only the authorized add fixture, not general Python programs.
+const pythonGuard = String.raw`
+import ast
+import hashlib
+import json
+import pathlib
+import sys
+import types
+
+expected = json.loads(sys.argv[1])
+sources = {}
+for name, digest in expected.items():
+    raw = pathlib.Path(name).read_bytes()
+    if hashlib.sha256(raw).hexdigest() != digest:
+        raise ValueError("source changed before execution: " + name)
+    sources[name] = raw.decode("utf-8-sig")
+
+def is_docstring(node):
+    return isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant) and isinstance(node.value.value, str)
+
+def without_docstring(nodes):
+    return nodes[1:] if nodes and is_docstring(nodes[0]) else nodes
+
+def arithmetic(node):
+    if isinstance(node, ast.Name):
+        return node.id in ("a", "b")
+    if isinstance(node, ast.Constant):
+        return type(node.value) in (int, float)
+    if isinstance(node, ast.BinOp):
+        return isinstance(node.op, (ast.Add, ast.Sub, ast.Mult, ast.Div, ast.FloorDiv, ast.Mod, ast.Pow)) and arithmetic(node.left) and arithmetic(node.right)
+    if isinstance(node, ast.UnaryOp):
+        return isinstance(node.op, (ast.UAdd, ast.USub)) and arithmetic(node.operand)
+    return False
+
+tree = ast.parse(sources["shadow_math.py"], filename="shadow_math.py")
+body = without_docstring(tree.body)
+if len(body) != 1 or not isinstance(body[0], ast.FunctionDef) or body[0].name != "add":
+    raise ValueError("shadow_math.py must contain only an optional docstring and def add(a, b)")
+function = body[0]
+args = function.args
+if (function.decorator_list or function.returns is not None or getattr(function, "type_params", [])
+    or args.posonlyargs or args.kwonlyargs or args.vararg or args.kwarg or args.defaults or args.kw_defaults
+    or [arg.arg for arg in args.args] != ["a", "b"] or any(arg.annotation is not None for arg in args.args)):
+    raise ValueError("add must have exactly unannotated a, b parameters without defaults or decorators")
+statements = without_docstring(function.body)
+if len(statements) != 1 or not isinstance(statements[0], ast.Return) or not arithmetic(statements[0].value):
+    raise ValueError("add must return a pure arithmetic expression of a, b, and numeric constants")
+
+def load_math():
+    module = types.ModuleType("shadow_math")
+    module.__file__ = str(pathlib.Path("shadow_math.py").resolve())
+    exec(compile(tree, "shadow_math.py", "exec"), module.__dict__)
+    sys.modules["shadow_math"] = module
+    return module
+`;
+
+const fixedCases = `${pythonGuard}
+math = load_math()
+pairs = [(1, 2), (0, 0), (-2, -5), (5, -8), (-9, 9), (123456789012345678901234567890, 987654321098765432109876543210)]
+failures = []
+for a, b in pairs:
+    try:
+        actual = math.add(a, b)
+        passed = type(actual) is int and actual == a + b
+        print(json.dumps({"a": a, "b": b, "actual": actual, "expected": a + b, "passed": passed}))
+        if not passed:
+            failures.append([a, b])
+    except Exception as error:
+        failures.append([a, b])
+        print(repr(error), file=sys.stderr)
+sys.exit(1 if failures else 0)
+`;
+
+const generatedUnittest = `${pythonGuard}
+import unittest
+import os
+completion_write = os.write
+completion_encode = json.dumps
+try:
+    load_math()
+    test_module = types.ModuleType("test_shadow_math")
+    test_module.__file__ = str(pathlib.Path("test_shadow_math.py").resolve())
+    sys.modules["test_shadow_math"] = test_module
+    exec(compile(sources["test_shadow_math.py"], "test_shadow_math.py", "exec"), test_module.__dict__)
+    suite = unittest.defaultTestLoader.loadTestsFromModule(test_module)
+    count = suite.countTestCases()
+    result = unittest.TextTestRunner(verbosity=2).run(suite)
+    successful = result.wasSuccessful()
+    if count < 2:
+        print("Generated unittest must contain at least two test cases; observed " + str(count), file=sys.stderr)
+    completion_write(3, completion_encode({"count": count, "testsRun": result.testsRun, "skipped": len(result.skipped), "expectedFailures": len(result.expectedFailures), "successful": successful, "completed": True}).encode("utf-8"))
+except BaseException:
+    import traceback
+    traceback.print_exc()
+    sys.exit(1)
+sys.exit(0 if count >= 2 and successful else 1)
+`;
+
+function finishLog(receipt: CommandReceipt): CommandReceipt {
+  receipt.logSHA256 = sha256(JSON.stringify({ stdout: receipt.stdout, stderr: receipt.stderr }));
+  return receipt;
+}
+
+async function runCommand(receipt: CommandReceipt): Promise<CommandReceipt> {
+  return new Promise((done) => {
+    const stdout: Buffer[] = [];
+    const stderr: Buffer[] = [];
+    const completion: Buffer[] = [];
+    let bytes = 0;
+    let completionBytes = 0;
+    const child = spawn(receipt.argv[0]!, receipt.argv.slice(1), {
+      cwd: receipt.cwd,
+      shell: false,
+      windowsHide: true,
+      env: { ...process.env, PYTHONDONTWRITEBYTECODE: "1", PYTHONIOENCODING: "utf-8" },
+      stdio: ["ignore", "pipe", "pipe", "pipe"],
+    });
+    const timer = setTimeout(() => {
+      receipt.timedOut = true;
+      child.kill("SIGKILL");
+    }, commandTimeout);
+    const capture = (target: Buffer[], chunk: Buffer) => {
+      const available = outputLimit - bytes;
+      if (available > 0) target.push(chunk.subarray(0, available));
+      bytes += Math.min(available, chunk.length);
+      if (chunk.length > available) {
+        receipt.truncated = true;
+        child.kill("SIGKILL");
+      }
+    };
+    child.stdout!.on("data", (chunk: Buffer) => capture(stdout, chunk));
+    child.stderr!.on("data", (chunk: Buffer) => capture(stderr, chunk));
+    child.stdio[3]!.on("data", (chunk: Buffer) => {
+      const available = Math.max(0, 4096 - completionBytes);
+      if (available > 0) completion.push(chunk.subarray(0, available));
+      completionBytes += chunk.length;
+      if (completionBytes > 4096) {
+        receipt.unittestCompletionError = "Unittest completion exceeded 4096 bytes";
+        child.kill("SIGKILL");
+      }
+    });
+    child.on("error", (error) => { receipt.error = errorText(error); });
+    child.on("close", (code, signal) => {
+      clearTimeout(timer);
+      receipt.exitCode = code;
+      receipt.signal = signal;
+      receipt.stdout = Buffer.concat(stdout).toString("utf8");
+      receipt.stderr = Buffer.concat(stderr).toString("utf8");
+      if (receipt.name === "generated-unittest") {
+        receipt.unittestCompletionRaw = Buffer.concat(completion).toString("utf8");
+        if (!receipt.unittestCompletionError) {
+          try {
+            if (!receipt.unittestCompletionRaw) throw new Error("Missing unittest completion on private fd3");
+            const record: unknown = JSON.parse(receipt.unittestCompletionRaw);
+            if (record === null || typeof record !== "object" || Array.isArray(record)) throw new Error("Invalid unittest completion record");
+            const fields = record as Record<string, unknown>;
+            if (![fields.count, fields.testsRun, fields.skipped, fields.expectedFailures].every((value) =>
+              typeof value === "number" && Number.isInteger(value) && value >= 0) ||
+              typeof fields.successful !== "boolean" || fields.completed !== true) {
+              throw new Error("Invalid unittest completion fields");
+            }
+            receipt.unittestCompletion = {
+              count: fields.count as number,
+              testsRun: fields.testsRun as number,
+              skipped: fields.skipped as number,
+              expectedFailures: fields.expectedFailures as number,
+              successful: fields.successful,
+              completed: true,
+            };
+          } catch (error) {
+            receipt.unittestCompletionError = errorText(error);
+          }
+        }
+      }
+      done(finishLog(receipt));
+    });
+  });
+}
+
+function succeeded(command: CommandReceipt): boolean {
+  return !command.skipped && command.exitCode === 0 && !command.error && !command.timedOut && !command.truncated &&
+    (command.name !== "generated-unittest" || (!command.unittestCompletionError &&
+      command.unittestCompletion?.completed === true && command.unittestCompletion.count >= 2 &&
+      command.unittestCompletion.testsRun >= 2 && command.unittestCompletion.testsRun === command.unittestCompletion.count &&
+      command.unittestCompletion.skipped === 0 && command.unittestCompletion.expectedFailures === 0 &&
+      command.unittestCompletion.successful === true));
+}
+
+export async function inspectDevelopmentWorkspace({ taskID, workspace, python = "python3" }: {
+  taskID: string;
+  workspace: string;
+  python?: string;
+}): Promise<DevelopmentWorkspaceReceipt> {
+  const receipt: DevelopmentWorkspaceReceipt = { taskID, workspace: resolve(workspace), sources: [], commands: [], errors: [], passed: false };
+  try {
+    receipt.workspace = await realpath(receipt.workspace);
+  } catch (error) {
+    receipt.errors.push(`Workspace: ${errorText(error)}`);
+  }
+  if (!taskID.trim()) receipt.errors.push("Task ID is required");
+  for (const name of sourceNames) {
+    let digest: string | null = null;
+    try {
+      digest = sha256(await readFile(join(receipt.workspace, name)));
+    } catch (error) {
+      receipt.errors.push(`${name}: ${errorText(error)}`);
+    }
+    receipt.sources.push({ path: name, sha256: digest, afterSHA256: null });
+  }
+  const sourceHashes = Object.fromEntries(receipt.sources.map((source) => [source.path, source.sha256]));
+  const programs = [["ast-guard", pythonGuard], ["fixed-cases", fixedCases], ["generated-unittest", generatedUnittest]] as const;
+  for (const [name, program] of programs) {
+    const command: CommandReceipt = {
+      name, taskID, argv: [python, "-c", program, JSON.stringify(sourceHashes)], cwd: receipt.workspace,
+      sourceHashes: { ...sourceHashes }, exitCode: null, signal: null, stdout: "", stderr: "", logSHA256: "",
+      timedOut: false, truncated: false, skipped: false,
+    };
+    if (receipt.errors.length || (name !== "ast-guard" && !succeeded(receipt.commands[0]!))) {
+      command.skipped = true;
+      command.error = "Skipped because source collection or the AST guard failed";
+      receipt.commands.push(finishLog(command));
+      continue;
+    }
+    try {
+      receipt.commands.push(await runCommand(command));
+    } catch (error) {
+      command.error = errorText(error);
+      receipt.commands.push(finishLog(command));
+    }
+  }
+  for (const source of receipt.sources) {
+    try {
+      source.afterSHA256 = sha256(await readFile(join(receipt.workspace, source.path)));
+      if (source.afterSHA256 !== source.sha256) receipt.errors.push(`${source.path} changed during acceptance`);
+    } catch (error) {
+      receipt.errors.push(`${source.path} after execution: ${errorText(error)}`);
+    }
+  }
+  receipt.passed = receipt.errors.length === 0 && receipt.commands.every(succeeded);
+  return receipt;
+}
