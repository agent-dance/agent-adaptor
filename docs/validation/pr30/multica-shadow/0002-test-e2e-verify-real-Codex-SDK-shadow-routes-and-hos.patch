+import { expect, test } from "@playwright/test";
+import { mkdtemp, readFile, readdir, rm, stat, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { appendShadowReport } from "./agent-adaptor-shadow.report";
+
+async function withReport(run: (path: string) => Promise<void>): Promise<void> {
+  const directory = await mkdtemp(join(tmpdir(), "multica-shadow-report-"));
+  try {
+    await run(join(directory, "nested", "report.json"));
+  } finally {
+    await rm(directory, { recursive: true, force: true });
+  }
+}
+
+test("native requires its one case to pass explicitly", async () => {
+  for (const passed of [true, false, undefined, null, "true", 1]) {
+    await withReport(async (path) => {
+      const report = await appendShadowReport(path, "run-1", "native", { name: "native-routing", passed, evidence: "case evidence" });
+      expect(report).toEqual({
+        runID: "run-1", phase: "native", expectedCases: 1, complete: true,
+        passed: passed === true, cases: [{ name: "native-routing", passed, evidence: "case evidence" }],
+      });
+      expect(JSON.parse(await readFile(path, "utf8"))).toEqual(JSON.parse(JSON.stringify(report)));
+      if (process.platform !== "win32") expect((await stat(path)).mode & 0o777).toBe(0o600);
+    });
+  }
+});
+
+test("shadow report becomes complete and passed only after all four cases", async () => {
+  await withReport(async (path) => {
+    for (let index = 1; index <= 4; index++) {
+      const report = await appendShadowReport(path, "run-1", "agent-adaptor", { name: `case-${index}`, passed: true });
+      expect(report.expectedCases).toBe(4);
+      expect(report.cases.map((entry) => entry.name)).toEqual(Array.from({ length: index }, (_, i) => `case-${i + 1}`));
+      expect(report.complete).toBe(index === 4);
+      expect(report.passed).toBe(index === 4);
+    }
+    const content = await readFile(path, "utf8");
+    await expect(appendShadowReport(path, "run-1", "agent-adaptor", { name: "extra", passed: true })).rejects.toThrow();
+    expect(await readFile(path, "utf8")).toBe(content);
+  });
+});
+
+test("fresh module after a worker restart preserves earlier failed evidence", async () => {
+  await withReport(async (path) => {
+    await appendShadowReport(path, "run-1", "agent-adaptor", { name: "case-1", passed: false, error: "old worker failed" });
+    const restarted = await import(`./agent-adaptor-shadow.report.ts?worker=${Date.now()}`);
+    for (let index = 2; index <= 4; index++) {
+      await restarted.appendShadowReport(path, "run-1", "agent-adaptor", { name: `case-${index}`, passed: true });
+    }
+    const report = JSON.parse(await readFile(path, "utf8"));
+    expect(report.complete).toBe(true);
+    expect(report.passed).toBe(false);
+    expect(report.cases).toHaveLength(4);
+    expect(report.cases[0]).toEqual({ name: "case-1", passed: false, error: "old worker failed" });
+  });
+});
+
+test("different runs, phases, and duplicate names cannot overwrite a report", async () => {
+  await withReport(async (path) => {
+    await appendShadowReport(path, "run-1", "agent-adaptor", { name: "case-1", passed: false });
+    const content = await readFile(path, "utf8");
+    for (const append of [
+      () => appendShadowReport(path, "run-2", "agent-adaptor", { name: "case-2", passed: true }),
+      () => appendShadowReport(path, "run-1", "native", { name: "native", passed: true }),
+      () => appendShadowReport(path, "run-1", "agent-adaptor", { name: "case-1", passed: true }),
+    ]) {
+      await expect(append()).rejects.toThrow();
+      expect(await readFile(path, "utf8")).toBe(content);
+    }
+  });
+});
+
+test("malformed existing reports and invalid new identity are rejected unchanged", async () => {
+  await withReport(async (path) => {
+    await appendShadowReport(path, "run-1", "agent-adaptor", { name: "case-1", passed: true });
+    for (const content of [
+      "not JSON", "null",
+      JSON.stringify({ runID: "run-1", phase: "agent-adaptor", expectedCases: 4, cases: [{ name: "same" }, { name: "same" }] }),
+      JSON.stringify({ runID: "run-1", phase: "agent-adaptor", expectedCases: 1, cases: [] }),
+      JSON.stringify({ runID: "run-1", phase: "agent-adaptor", expectedCases: 4, cases: [null] }),
+    ]) {
+      await writeFile(path, content);
+      await expect(appendShadowReport(path, "run-1", "agent-adaptor", { name: "case-2", passed: true })).rejects.toThrow();
+      expect(await readFile(path, "utf8")).toBe(content);
+    }
+  });
+  await withReport(async (path) => {
+    await expect(appendShadowReport(path, " ", "native", { name: "native", passed: true })).rejects.toThrow();
+    await expect(appendShadowReport(path, "run-1", "native", { name: " ", passed: true })).rejects.toThrow();
+    await expect(readFile(path)).rejects.toMatchObject({ code: "ENOENT" });
+  });
+});
+
+test("atomic appends leave only the final report file", async () => {
+  await withReport(async (path) => {
+    await appendShadowReport(path, "run-1", "native", { name: "native", passed: true });
+    expect(await readdir(join(path, ".."))).toEqual(["report.json"]);
+  });
+});
