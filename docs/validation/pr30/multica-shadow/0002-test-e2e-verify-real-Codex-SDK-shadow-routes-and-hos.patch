+++ b/e2e/agent-adaptor-shadow.report.ts
@@ -0,0 +1,78 @@
+import { randomUUID } from "node:crypto";
+import { mkdir, readFile, rename, rm, writeFile } from "node:fs/promises";
+import { dirname } from "node:path";
+
+type ShadowPhase = "native" | "agent-adaptor";
+type ShadowCase = { name: string; passed?: unknown; [key: string]: unknown };
+
+interface ShadowReport {
+  runID: string;
+  phase: ShadowPhase;
+  expectedCases: number;
+  complete: boolean;
+  passed: boolean;
+  cases: ShadowCase[];
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+function isCase(value: unknown): value is ShadowCase {
+  return isRecord(value) && typeof value.name === "string" && value.name.trim() !== "";
+}
+
+export async function appendShadowReport(
+  path: string,
+  runID: string,
+  phase: ShadowPhase,
+  entry: ShadowCase,
+): Promise<ShadowReport> {
+  if (!runID.trim()) throw new Error("A shadow report run ID is required");
+  if (phase !== "native" && phase !== "agent-adaptor") throw new Error("Unknown shadow report phase");
+  if (!isCase(entry)) throw new Error("A shadow report case name is required");
+  const expectedCases = phase === "native" ? 1 : 4;
+  let cases: ShadowCase[] = [];
+  let existing: string | undefined;
+  try {
+    existing = await readFile(path, "utf8");
+  } catch (error) {
+    if (!isRecord(error) || error.code !== "ENOENT") throw error;
+  }
+  if (existing !== undefined) {
+    const report: unknown = JSON.parse(existing);
+    if (!isRecord(report) || report.runID !== runID || report.phase !== phase) {
+      throw new Error("Existing shadow report belongs to another run or phase");
+    }
+    if (report.expectedCases !== expectedCases || !Array.isArray(report.cases) || !report.cases.every(isCase)) {
+      throw new Error("Existing shadow report has invalid cases or expected count");
+    }
+    cases = report.cases;
+    if (new Set(cases.map((item) => item.name)).size !== cases.length) {
+      throw new Error("Existing shadow report contains duplicate cases");
+    }
+  }
+  if (cases.some((item) => item.name === entry.name)) throw new Error(`Duplicate shadow report case: ${entry.name}`);
+  if (cases.length >= expectedCases) throw new Error("Shadow report already has all expected cases");
+  cases = [...cases, entry];
+  const complete = cases.length === expectedCases;
+  const report: ShadowReport = {
+    runID,
+    phase,
+    expectedCases,
+    complete,
+    passed: complete && cases.every((item) => item.passed === true),
+    cases,
+  };
+  const content = `${JSON.stringify(report, null, 2)}\n`;
+  await mkdir(dirname(path), { recursive: true });
+  const temporary = `${path}.${randomUUID()}.tmp`;
+  try {
+    await writeFile(temporary, content, { mode: 0o600, flag: "wx" });
+    await rename(temporary, path);
+  } catch (error) {
+    await rm(temporary, { force: true }).catch(() => undefined);
+    throw error;
+  }
+  return report;
+}
