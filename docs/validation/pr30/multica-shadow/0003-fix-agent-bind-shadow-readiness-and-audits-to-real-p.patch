+func (s *adaptorSession) observeProviderTurn(event adaptor.Event, emit func(Message)) {
+	source := event.Meta().Source
+	if source == nil {
+		return
+	}
+	if source.ThreadID != "" {
+		s.observedSession = source.ThreadID
+	}
+	// Only a formal, turn-scoped active semantic event establishes observed
+	// provider execution. Process start, init, transcript notices and terminals
+	// cannot open the host claim gate. The SDK still owns the delivery window
+	// and its actual MessageUpdate decides the eventual HTTP ACK.
+	active := false
+	switch e := event.(type) {
+	case adaptor.ToolCall:
+		active = e.Phase == adaptor.PhaseStart || e.Phase == adaptor.PhaseContent
+	case adaptor.TextDelta:
+		active = e.Phase == adaptor.PhaseStart || e.Phase == adaptor.PhaseContent
+	case adaptor.Thinking:
+		active = e.Phase == adaptor.PhaseStart || e.Phase == adaptor.PhaseContent
+	case *adaptor.ApprovalRequest:
+		active = true
+	}
+	turn := adaptorProviderTurn{thread: source.ThreadID, turn: source.TurnID}
+	if !active || !s.canSupplement || turn.thread == "" || turn.turn == "" || s.providerEnded {
+		return
+	}
+	if _, ended := s.endedTurns[turn]; ended {
+		return
+	}
+	if s.activeTurn == turn && s.ready.Load() {
+		return
+	}
+	s.activeTurn = turn
+	s.ready.Store(true)
+	s.logger.Info("agent-adaptor live turn", "task_id", s.task, "run_id", s.stream.RunID(), "turn_id", turn.turn, "provider_session_id", turn.thread, "prior_provider_session_id", s.priorSession)
+	emit(Message{Type: MessageLog, Level: "info", Content: "agent-adaptor live_turn run_id=" + s.stream.RunID()})
+}
