+package agent
+
+import (
+	"bytes"
+	"context"
+	"log/slog"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+	"time"
+)
+
+// This uses the real captured Codex driver, app-server parser and public
+// Thread.Send/Event pipeline. A fake Driver emitting a RunStarted directly
+// would miss that core suppresses the provider's duplicate lifecycle event.
+func TestAdaptorShadowRealAppServerSemanticEventOpensSupplementGate(t *testing.T) {
+	base := t.TempDir()
+	command := filepath.Join(base, "offline-app-server")
+	if runtime.GOOS == "windows" {
+		command += ".exe"
+	}
+	build := exec.CommandContext(t.Context(), "go", "build", "-o", command, "./testdata/shadow-appserver")
+	if output, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("build private offline protocol peer: %v\n%s", err, output)
+	}
+	var logs bytes.Buffer
+	b := newAdaptorBackend(Config{ExecutablePath: command, AdaptorThreadKey: "real-sdk/offline-business-key", TaskID: "fixture-task", Env: map[string]string{"CODEX_HOME": filepath.Join(base, "private-empty-profile")}, Logger: slog.New(slog.NewTextHandler(&logs, nil))})
+	b.conversations = &adaptorConversations{byKey: map[string]*adaptorConversation{}}
+	ctx, cancel := context.WithTimeout(t.Context(), 10*time.Second)
+	defer cancel()
+	session, err := b.Execute(ctx, "wait for guidance", ExecOptions{Cwd: base, EnableTaskSupplement: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if session.SupplementInput == nil {
+		t.Fatal("real version-gated app-server capability was unavailable")
+	}
+	started := false
+	for message := range session.Messages {
+		if message.Type == MessageStatus && message.Status == "task_started" {
+			started = true
+		}
+		if message.Type == MessageLog && strings.Contains(message.Content, "live_turn") {
+			if !started || !session.SupplementReady() {
+				t.Fatal("official tool-call source did not open the gate after core start")
+			}
+			if err := session.SupplementInput(ctx, SupplementInput{ID: "original-comment", Text: "original guidance 😀", AuthorType: "member", AuthorName: "offline human"}); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	result := awaitShadow(t, session.Result)
+	if result.Status != "completed" || result.SessionID != "fixture-thread" || result.Output != "fixture complete" || session.SupplementReady() || !session.TerminalObserved() {
+		t.Fatalf("actual public SDK completion=%+v ready=%v terminal=%v\n%s", result, session.SupplementReady(), session.TerminalObserved(), logs.String())
+	}
+	for _, evidence := range []string{"agent-adaptor live turn", "turn_id=fixture-turn", "provider_session_id=fixture-thread", "message_id=original-comment state=delivered", "boundary=immediate", "observed_provider_session_id=fixture-thread", "cleanup_confirmed=true"} {
+		if !strings.Contains(logs.String(), evidence) {
+			t.Fatalf("missing actual protocol evidence %q:\n%s", evidence, logs.String())
+		}
+	}
+}
