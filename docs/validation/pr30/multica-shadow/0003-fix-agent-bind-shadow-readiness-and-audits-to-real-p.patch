+// This offline peer implements only the official protocol frames used by the
+// shadow regression. It never resolves Codex, reads auth, or calls a model.
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"strings"
+)
+
+func main() {
+	for _, arg := range os.Args[1:] {
+		if arg == "--version" {
+			fmt.Println("codex-cli 0.166.0")
+			return
+		}
+	}
+	if len(os.Args) < 2 || os.Args[1] != "app-server" {
+		os.Exit(71) // An accidental exec transport must fail this regression.
+	}
+	writer := bufio.NewWriter(os.Stdout)
+	write := func(value any) {
+		if json.NewEncoder(writer).Encode(value) != nil || writer.Flush() != nil {
+			os.Exit(72)
+		}
+	}
+	notify := func(method string, params any) {
+		write(map[string]any{"method": method, "params": params})
+	}
+	decoder := json.NewDecoder(os.Stdin)
+	for {
+		var request struct {
+			ID     json.RawMessage `json:"id"`
+			Method string          `json:"method"`
+			Params json.RawMessage `json:"params"`
+		}
+		if decoder.Decode(&request) != nil {
+			return
+		}
+		respond := func(result any) {
