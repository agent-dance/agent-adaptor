+	// The SDK's healthy checkpoint is authoritative for shadow sessions. Its
+	// profile may differ from the native rollout store inspected by the daemon.
+	return sessionID != "" && !isCodexAdaptorShadow(provider, codexBackend) && !nativeProbe()
+}
