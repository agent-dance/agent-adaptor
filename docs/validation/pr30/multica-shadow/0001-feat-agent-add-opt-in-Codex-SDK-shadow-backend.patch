+}
+func drainShadow(s *Session) <-chan Result {
+	out := make(chan Result, 1)
+	go func() {
+		for range s.Messages {
+		}
+		out <- <-s.Result
+		close(out)
+	}()
+	return out
+}
+func awaitShadow[T any](t *testing.T, ch <-chan T) T {
+	t.Helper()
+	select {
+	case v := <-ch:
+		return v
+	case <-time.After(5 * time.Second):
+		t.Fatal("bounded shadow operation timed out")
+		var zero T
+		return zero
+	}
+}
