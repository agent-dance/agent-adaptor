+package agent
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"log/slog"
+	"sort"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	adaptor "github.com/agent-dance/agent-adaptor/v2"
+	sdkcodex "github.com/agent-dance/agent-adaptor/v2/codex"
+	"github.com/agent-dance/agent-adaptor/v2/driver"
+	"github.com/agent-dance/agent-adaptor/v2/memory"
+)
+
+var errAdaptorLegacyResume = errors.New("agent-adaptor shadow cannot import a legacy or unknown provider session; start a new SDK conversation")
+
+// The experiment deliberately stores SDK checkpoints only in this daemon.
+// A restart cannot claim durable or legacy-session migration coverage.
+type adaptorConversation struct {
+	store          *memory.Store
+	session        string
+	busy, poisoned bool
+}
+type adaptorConversations struct {
+	mu    sync.Mutex
+	byKey map[string]*adaptorConversation
+}
+
+var processAdaptorConversations = adaptorConversations{byKey: map[string]*adaptorConversation{}}
+
+type adaptorBackend struct {
+	cfg           Config
+	conversations *adaptorConversations
+	newDriver     func(sdkcodex.Config) driver.Driver
+}
+
+func newAdaptorBackend(cfg Config) *adaptorBackend {
+	if cfg.Logger == nil {
+		cfg.Logger = slog.Default()
+	}
+	return &adaptorBackend{cfg: cfg, conversations: &processAdaptorConversations, newDriver: sdkcodex.Driver}
+}
+
+func (b *adaptorBackend) reserve(opts ExecOptions) (*adaptorConversation, error) {
+	if b.cfg.AdaptorThreadKey == "" {
+		return nil, errors.New("agent-adaptor shadow requires a host business Thread key")
+	}
+	b.conversations.mu.Lock()
+	defer b.conversations.mu.Unlock()
+	entry := b.conversations.byKey[b.cfg.AdaptorThreadKey]
+	if entry != nil && entry.busy {
+		return nil, errors.New("agent-adaptor shadow business Thread is busy")
+	}
+	if entry != nil && entry.poisoned {
+		return nil, errors.New("agent-adaptor shadow previous process cleanup is unconfirmed")
+	}
+	if opts.ResumeSessionID != "" {
+		if entry == nil || entry.session == "" || entry.session != opts.ResumeSessionID {
+			return nil, errAdaptorLegacyResume
+		}
+	} else if entry == nil {
+		// The host business key, rather than a provider handle, owns continuity.
+		// A new conversation requires a new key; never reset a known key's store.
+		entry = &adaptorConversation{store: memory.NewStore()}
+		b.conversations.byKey[b.cfg.AdaptorThreadKey] = entry
+	}
+	entry.busy = true
+	return entry, nil
+}
+func (b *adaptorBackend) release(entry *adaptorConversation, session string, poisoned bool) {
+	b.conversations.mu.Lock()
+	defer b.conversations.mu.Unlock()
+	entry.busy = false
+	entry.poisoned = poisoned
+	if session != "" {
+		entry.session = session
+	}
+}
+
+func (b *adaptorBackend) Execute(ctx context.Context, prompt string, opts ExecOptions) (*Session, error) {
+	if len(b.cfg.LaunchPrefix) > 0 {
+		return nil, errors.New("agent-adaptor shadow does not support custom runtime launch prefixes")
+	}
+	if opts.ServiceTier != "" && opts.ServiceTier != "default" && opts.ServiceTier != "priority" {
+		return nil, errors.New("agent-adaptor shadow does not support this Codex service tier")
+	}
+	entry, err := b.reserve(opts)
+	if err != nil {
+		return nil, err
+	}
+	cfg := b.codexConfig(opts)
+	policy := adaptor.Policy{Approvals: adaptor.ApprovalPolicy{Permission: adaptor.ApprovalAutoApprove}}
+	policy.Messages.Disabled = !opts.EnableTaskSupplement
+	a := adaptor.New(b.newDriver(cfg), adaptor.WithWorkspace(opts.Cwd), adaptor.WithThreadStore(entry.store), adaptor.WithPolicy(policy), adaptor.WithInstructions(opts.SystemPrompt), adaptor.WithBlockingEvents())
+	// The daemon already materializes the effective MCP configuration and runtime
+	// brief in its task CODEX_HOME/workspace. Do not synthesize another profile.
+	runCtx, cancel := runContext(ctx, opts.Timeout)
+	probeCtx, cancelProbe := context.WithTimeout(runCtx, 10*time.Second)
+	environment, probeErr := a.Inspect().Environment(probeCtx)
+	cancelProbe()
+	if probeErr != nil || !environment.Healthy {
+		cancel()
+		closeCtx, closeCancel := context.WithTimeout(context.Background(), 10*time.Second)
+		closeErr := a.Close(closeCtx)
+		closeCancel()
+		b.release(entry, "", closeErr != nil)
+		if probeErr == nil {
+			probeErr = fmt.Errorf("agent-adaptor environment unavailable: %s", environment.Summary)
+		}
+		return nil, errors.Join(probeErr, closeErr)
+	}
+	canSupplement := environment.Version != "" && len(environment.Messages.Boundaries) > 0 && opts.EnableTaskSupplement
+	// Multica's native backend permits a disclosed fresh-session fallback.
+	// Let the SDK retain its bounded continuity and reject unsafe resume itself;
+	// task-scoped environment changes must never be hidden from its fingerprint.
+	thread := a.Thread(b.cfg.AdaptorThreadKey)
+	stream := thread.Send(runCtx, prompt, adaptor.MessageID(b.cfg.TaskID))
+	bridge := &adaptorSession{stream: stream, waiters: map[string]*adaptorReceipt{}, logger: b.cfg.Logger, task: b.cfg.TaskID, priorSession: opts.ResumeSessionID, continuityNotice: opts.ResumeContinuityNotice, canSupplement: canSupplement}
+	messages := make(chan Message, 256)
+	results := make(chan Result, 1)
+	session := &Session{CleanupRequired: true, Messages: messages, Result: results, SupplementReady: bridge.ready.Load, TerminalObserved: bridge.terminal.Load}
+	if canSupplement {
+		session.SupplementInput = bridge.supplement
+	}
+	b.cfg.Logger.Info("agent-adaptor shadow execution started", "task_id", b.cfg.TaskID, "run_id", stream.RunID(), "version", environment.Version, "resume", opts.ResumeSessionID != "")
+	go b.consume(runCtx, cancel, a, thread, entry, opts, bridge, messages, results)
+	return session, nil
+}
+
+func (b *adaptorBackend) codexConfig(opts ExecOptions) sdkcodex.Config {
+	cfg := sdkcodex.Config{Model: opts.Model, ReasoningEffort: sdkcodex.ReasoningEffort(opts.ThinkingLevel), FastMode: opts.ServiceTier == "priority"}
+	cfg.Command = b.cfg.ExecutablePath
+	cfg.ExtraArgs = NormalizeCodexLaunchArgs(opts.ExtraArgs, opts.CustomArgs, opts.McpConfig, b.cfg.Logger)
+	if opts.ServiceTier == "default" {
+		cfg.ExtraArgs = append(cfg.ExtraArgs, "-c", `service_tier="default"`)
+	}
+	keys := make([]string, 0, len(b.cfg.Env))
+	for key := range b.cfg.Env {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	for _, key := range keys {
+		cfg.Env = append(cfg.Env, driver.EnvBinding{Name: key, Value: b.cfg.Env[key]})
+	}
+	return cfg
+}
+
+func (b *adaptorBackend) consume(runCtx context.Context, cancel context.CancelFunc, a *adaptor.Agent, thread *adaptor.Thread, entry *adaptorConversation, opts ExecOptions, bridge *adaptorSession, messages chan Message, results chan Result) {
+	stream := bridge.stream
+	started := time.Now()
+	defer cancel()
+	defer close(results)
+	emit := func(message Message) {
+		select {
+		case messages <- message:
+		case <-runCtx.Done():
+		}
+	}
+	emit(Message{Type: MessageLog, Level: "info", Content: "agent-adaptor run_id=" + stream.RunID() + " backend=shadow"})
+	var observedSession string
+	for event := range stream.Events() {
+		if startedEvent, ok := event.(adaptor.RunStarted); ok && startedEvent.ThreadID != "" {
+			observedSession = startedEvent.ThreadID
+		}
+		bridge.observe(event, emit)
+	}
+	result, runErr := stream.Result()
+	var runError *adaptor.RunError
+	if result == nil && errors.As(runErr, &runError) {
+		result = runError.Result
+	}
+	if result != nil {
+		for _, outcome := range result.Messages() {
+			bridge.receipt(outcome.ID, outcome.State, outcome.Reason)
+		}
+	}
+	bridge.finish()
+	checkpoint, checkpointErr := thread.Checkpoint(context.Background())
+	healthySession := ""
+	if checkpointErr == nil && checkpoint.Valid && checkpoint.State != nil {
+		healthySession = checkpoint.State.ResumeID
+	}
+	closeCtx, closeCancel := context.WithTimeout(context.Background(), 10*time.Second)
+	closeErr := a.Close(closeCtx)
+	closeCancel()
+	b.release(entry, healthySession, closeErr != nil)
+	// An announcement is useful protocol evidence, but only the SDK's healthy
+	// checkpoint may become Multica's subsequent continuation handle.
+	mapped := mapAdaptorResult(result, runErr, healthySession, time.Since(started))
+	if closeErr != nil {
+		mapped.Status = "cleanup_unconfirmed"
+		mapped.Error = "agent-adaptor process cleanup is unconfirmed: " + closeErr.Error()
+	}
+	bridge.terminal.Store(true)
+	b.cfg.Logger.Info("agent-adaptor shadow execution finished", "task_id", b.cfg.TaskID, "run_id", stream.RunID(), "status", mapped.Status, "cleanup_confirmed", closeErr == nil, "prior_provider_session_id", opts.ResumeSessionID, "observed_provider_session_id", observedSession, "checkpoint_provider_session_id", healthySession, "fresh_fallback", bridge.continuity.Load())
+	close(messages)
+	results <- mapped
+}
+
+type adaptorReceipt struct {
+	input    SupplementInput
+	done     chan struct{}
+	err      error
+	finished bool
+}
+type adaptorSession struct {
+	stream           adaptor.Stream
+	mu               sync.Mutex
+	waiters          map[string]*adaptorReceipt
+	finished         bool
+	ready, terminal  atomic.Bool
+	continuity       atomic.Bool
+	logger           *slog.Logger
+	task             string
+	priorSession     string
+	continuityNotice string
+	canSupplement    bool
+}
+
+func (s *adaptorSession) supplement(ctx context.Context, input SupplementInput) error {
+	if input.ID == "" {
+		return errors.New("agent-adaptor supplement requires the original comment ID")
+	}
+	kind := adaptor.AuthorHuman
+	switch input.AuthorType {
+	case "agent":
+		kind = adaptor.AuthorAgent
+	case "", "human", "user", "member":
+	default:
+		return errors.New("agent-adaptor supplement has unsupported author authority")
+	}
+	s.mu.Lock()
+	if s.finished {
+		s.mu.Unlock()
+		return &AdaptorSupplementError{Reason: "turn_ended"}
+	}
+	waiter, exists := s.waiters[input.ID]
+	if exists && waiter.input != input {
+		s.mu.Unlock()
+		return errors.New("agent-adaptor duplicate comment ID changed its content or author")
+	}
+	if !exists {
+		waiter = &adaptorReceipt{input: input, done: make(chan struct{})}
+		s.waiters[input.ID] = waiter
+	}
+	s.mu.Unlock()
+	if !exists {
+		err := s.stream.Send(ctx, input.Text, adaptor.MessageID(input.ID), adaptor.From(adaptor.Author{Kind: kind, ID: input.AuthorID, Name: input.AuthorName}), adaptor.When(adaptor.Soon))
+		if err != nil {
+			s.resolve(input.ID, err)
+		}
+	}
+	// Admission is not delivery. After SDK ownership transfer, only its actual
+	// receipt decides the daemon ACK, including a delivery/cancellation race.
+	<-waiter.done
+	return waiter.err
+}
+
+// AdaptorSupplementError exposes only the host's stable public receipt reason.
+type AdaptorSupplementError struct{ Reason string }
+
+func (e *AdaptorSupplementError) Error() string { return "agent-adaptor message delivery: " + e.Reason }
+
+func (s *adaptorSession) resolve(id string, err error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if waiter := s.waiters[id]; waiter != nil && !waiter.finished {
+		waiter.err = err
+		waiter.finished = true
+		close(waiter.done)
+	}
+}
+func (s *adaptorSession) receipt(id string, state adaptor.MessageState, reason adaptor.MessageFailure) {
+	if state == adaptor.MessageAccepted {
+		return
+	}
+	if state == adaptor.MessageDelivered {
+		s.resolve(id, nil)
+		return
+	}
+	code := "provider_rejected"
+	switch reason {
+	case adaptor.MessageCancelled, adaptor.MessageRunFailed, adaptor.MessageLimitExceeded:
+		code = "turn_ended"
+	case adaptor.MessageTimeout:
+		code = "timeout"
+	}
+	s.resolve(id, &AdaptorSupplementError{Reason: code})
+}
+func (s *adaptorSession) finish() {
+	s.ready.Store(false)
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.finished {
+		return
+	}
+	s.finished = true
+	for _, waiter := range s.waiters {
+		if !waiter.finished {
+			waiter.err = &AdaptorSupplementError{Reason: "turn_ended"}
+			waiter.finished = true
+			close(waiter.done)
+		}
+	}
+}
+
+func (s *adaptorSession) observe(event adaptor.Event, emit func(Message)) {
+	switch e := event.(type) {
+	case adaptor.RunStarted:
+		meta := e.Meta()
+		liveTurn := meta.TurnID != "" || (meta.Source != nil && meta.Source.TurnID != "")
+		s.ready.Store(s.canSupplement && liveTurn)
+		// Do not pin an announced provider ID before the SDK validates and saves
+		// a healthy checkpoint. Result is the authoritative continuation handle.
+		emit(Message{Type: MessageStatus, Status: "task_started"})
+		if s.ready.Load() {
+			turnID := meta.TurnID
+			if turnID == "" && meta.Source != nil {
+				turnID = meta.Source.TurnID
+			}
+			s.logger.Info("agent-adaptor live turn", "task_id", s.task, "run_id", s.stream.RunID(), "turn_id", turnID, "provider_session_id", e.ThreadID, "prior_provider_session_id", s.priorSession)
+			emit(Message{Type: MessageLog, Level: "info", Content: "agent-adaptor live_turn run_id=" + s.stream.RunID()})
+		}
+	case adaptor.RunFinished:
+		s.ready.Store(false)
+	case adaptor.TextDelta:
+		if e.Phase == adaptor.PhaseContent && e.Text != "" {
+			emit(Message{Type: MessageText, Content: e.Text})
+		}
+	case adaptor.Thinking:
+		if e.Phase == adaptor.PhaseContent && e.Text != "" {
+			emit(Message{Type: MessageThinking, Content: e.Text})
+		}
+	case adaptor.ToolCall:
+		if e.Phase == adaptor.PhaseStart {
+			emit(Message{Type: MessageToolUse, Tool: e.Name, CallID: e.ID, Input: e.Args})
+		} else if e.Phase == adaptor.PhaseEnd && e.Result != nil {
+			value, _ := json.Marshal(e.Result)
+			emit(Message{Type: MessageToolResult, CallID: e.ID, Output: string(value)})
+		}
+	case adaptor.ToolResult:
+		value, _ := json.Marshal(e.Result)
+		emit(Message{Type: MessageToolResult, CallID: e.ID, Output: string(value)})
+	case adaptor.MessageUpdate:
+		state := map[adaptor.MessageState]string{adaptor.MessageAccepted: "accepted", adaptor.MessageDelivered: "delivered", adaptor.MessageFailed: "failed"}[e.State]
+		// Record the actual SDK receipt before releasing the daemon's waiter,
+		// so an HTTP ACK cannot precede its delivery evidence in the local log.
+		s.logger.Info("agent-adaptor message receipt", "task_id", s.task, "run_id", s.stream.RunID(), "message_id", e.ID, "state", state, "boundary", e.Boundary, "reason", e.Reason)
+		s.receipt(e.ID, e.State, e.Reason)
+		emit(Message{Type: MessageLog, Level: "info", Content: fmt.Sprintf("agent-adaptor receipt run_id=%s message_id=%s state=%s boundary=%s reason=%s", s.stream.RunID(), e.ID, state, e.Boundary, e.Reason)})
+	case adaptor.Notice:
+		if e.Kind == "thread.continuity" {
+			s.continuity.Store(true)
+			s.logger.Warn("agent-adaptor continuity fallback", "task_id", s.task, "run_id", s.stream.RunID(), "prior_provider_session_id", s.priorSession, "notice", e.Text)
+			// Multica already presents host model-selection warnings as text.
+			// MessageLog alone is not persisted by executeAndDrain, so surface
+			// this actual SDK notice through the same visible transcript path.
+			text := "[Host continuity warning] " + e.Text + " Only bounded recent context may be available; full history was not resumed."
+			if s.continuityNotice != "" {
+				text += "\n" + s.continuityNotice
+			}
+			emit(Message{Type: MessageText, Content: text + "\n\n", Level: "warn"})
+			return
+		}
+		if e.Kind != adaptor.NoticeTranscriptItem && e.Text != "" {
+			emit(Message{Type: MessageLog, Level: "info", Content: e.Text})
+		}
+	case adaptor.Dropped:
+		emit(Message{Type: MessageLog, Level: "warn", Content: fmt.Sprintf("agent-adaptor dropped=%d reason=%s", e.Count, e.Reason)})
+	case adaptor.Done:
+		s.ready.Store(false)
+	}
+}
+
+func mapAdaptorResult(result *adaptor.Result, err error, session string, duration time.Duration) Result {
+	mapped := Result{Status: "completed", SessionID: session, DurationMs: duration.Milliseconds()}
+	if result != nil {
+		mapped.Output = result.Text
+		if result.Usage != nil {
+			// Codex reports cached input within total input; Multica accounts
+			// uncached input and cache reads as mutually exclusive buckets.
+			input := max(0, result.Usage.InputTokens-result.Usage.CachedInputTokens)
+			mapped.Usage = map[string]TokenUsage{result.Model: {InputTokens: int64(input), OutputTokens: int64(result.Usage.OutputTokens), CacheReadTokens: int64(result.Usage.CachedInputTokens)}}
+		}
+	}
+	if err != nil {
+		mapped.Status = "failed"
+		mapped.Error = err.Error()
+		var runError *adaptor.RunError
+		if errors.As(err, &runError) && runError.Reason != adaptor.ReasonCancelled {
+			// Preserve an authoritative provider verdict when cancellation only
+			// joined later cleanup/lease diagnostics into the SDK error.
+			return mapped
+		}
+		if errors.Is(err, context.DeadlineExceeded) {
+			mapped.Status = "timeout"
+		} else if errors.Is(err, context.Canceled) || errors.Is(err, adaptor.ErrRunCancelled) {
+			mapped.Status = "cancelled"
+		}
+	}
+	return mapped
+}
+
+var _ Backend = (*adaptorBackend)(nil)
