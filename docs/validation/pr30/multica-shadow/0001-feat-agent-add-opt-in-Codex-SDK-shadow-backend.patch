+func TestAdaptorShadowActualTaskEnvironmentFallsBackWithBoundedContext(t *testing.T) {
+	// This is the daemon's actual per-task shape: identity, private temporary
+	// directory, CLI config root, CODEX_HOME, and a freshly scoped API token.
+	// Every value must reach the new driver; none may be silently reused or
+	// mislabeled as a runtime secret to defeat SDK compatibility checks.
+	for _, failedReplacement := range []bool{false, true} {
+		t.Run(fmt.Sprintf("replacement_failure=%v", failedReplacement), func(t *testing.T) {
+			var calls atomic.Int32
+			base := t.TempDir()
+			b := shadowBackend(t, func(_ context.Context, r driver.Request, _ driver.EventSink) (driver.Response, error) {
+				n := calls.Add(1)
+				response := shadowCheckpoint(r)
+				if n == 1 {
+					response.Output = "previous verified work: preserve Unicode mentions"
+					return response, nil
+				}
+				if n != 2 {
+					t.Error("replacement was replayed after provider failure")
+				}
+				if r.Session != nil && r.Session.State != nil && r.Session.State.ResumeID != "" {
+					t.Error("old checkpoint reached a differently configured task")
+				}
+				if !strings.Contains(r.Prompt, "Recent assistant turns before this fresh session") || !strings.Contains(r.Prompt, "previous verified work") || !strings.Contains(r.Prompt, "task two objective") {
+					t.Errorf("new task lost current objective or bounded continuity: %q", r.Prompt)
+				}
+				if failedReplacement {
+					return driver.Response{Failure: &driver.RunFailure{Code: driver.FailureAgentError, Message: "real replacement failure"}}, nil
+				}
+				response.Checkpoint.State.ResumeID = "new-task-provider-session"
+				return response, nil
+			})
+			originalFactory := b.newDriver
+			var configs []sdkcodex.Config
+			b.newDriver = func(cfg sdkcodex.Config) driver.Driver {
+				configs = append(configs, cfg)
+				return originalFactory(cfg)
+			}
+			taskEnvironment := func(id string) map[string]string {
+				return map[string]string{
+					"MULTICA_TOKEN": "mat_offline_capability_" + id, "MULTICA_TASK_ID": id,
+					"MULTICA_TASK_CONFIG_ROOT":     filepath.Join(base, id, "multica"),
+					"MULTICA_TASK_WORKSPACES_ROOT": filepath.Join(base, id, "workspaces"),
+					"MULTICA_SERVER_URL":           "http://127.0.0.1:19014", "MULTICA_AGENT_ID": "same-agent",
+					"MULTICA_WORKSPACE_ID": "same-workspace", "MULTICA_TASK_SLOT": "0",
+					"TMPDIR": filepath.Join(base, id, "tmp"), "CODEX_HOME": filepath.Join(base, id, "codex"),
+				}
+			}
+			b.cfg.Env, b.cfg.TaskID = taskEnvironment("one"), "one"
+			opts := ExecOptions{Cwd: base}
+			s, err := b.Execute(t.Context(), "task one objective", opts)
+			if err != nil {
+				t.Fatal(err)
+			}
+			first := awaitShadow(t, drainShadow(s))
+			if first.Status != "completed" {
+				t.Fatalf("first=%+v", first)
+			}
+			opts.ResumeSessionID, opts.ResumeExpected = first.SessionID, true
+			opts.ResumeContinuityNotice = "Re-read this issue's comments before continuing."
+			b.cfg.Env, b.cfg.TaskID = taskEnvironment("two"), "two"
+			s, err = b.Execute(t.Context(), "task two objective", opts)
+			if err != nil {
+				t.Fatal(err)
+			}
+			notices := 0
+			for msg := range s.Messages {
+				if msg.Type == MessageText && strings.Contains(msg.Content, "[Host continuity warning]") {
+					notices++
+					if !strings.Contains(msg.Content, opts.ResumeContinuityNotice) {
+						t.Error("host's surface-specific notice was lost")
+					}
+				}
+			}
+			second := awaitShadow(t, s.Result)
+			if notices != 1 || calls.Load() != 2 {
+				t.Fatalf("notices=%d calls=%d", notices, calls.Load())
+			}
+			if failedReplacement {
+				if second.Status != "failed" || second.SessionID != first.SessionID {
+					t.Fatalf("failed replacement overwrote healthy checkpoint: %+v", second)
+				}
+			} else if second.Status != "completed" || second.SessionID == first.SessionID {
+				t.Fatalf("replacement=%+v", second)
+			}
+			if len(configs) != 2 {
+				t.Fatal("new task did not get its own configured driver")
+			}
+			actual := map[string]string{}
+			for _, env := range configs[1].Env {
+				actual[env.Name] = env.Value
+			}
+			for name, value := range b.cfg.Env {
+				if actual[name] != value {
+					t.Errorf("current task binding %s was lost or stale", name)
+				}
+			}
+		})
+	}
+}
