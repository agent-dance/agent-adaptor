+func parseCodexBackend(raw string) (string, error) {
+	switch strings.TrimSpace(raw) {
+	case "", "native":
+		return "native", nil
+	case "agent-adaptor":
+		return "agent-adaptor", nil
+	default:
+		return "", fmt.Errorf("MULTICA_CODEX_BACKEND must be native or agent-adaptor")
+	}
+}
+
