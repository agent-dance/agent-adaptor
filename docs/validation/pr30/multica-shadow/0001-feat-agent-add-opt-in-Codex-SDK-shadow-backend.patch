+func TestAdaptorShadowRealCodexValidatesNormalizedLaunchConfiguration(t *testing.T) {
+	for _, test := range []struct {
+		name          string
+		extra, custom []string
+		invalid       bool
+	}{
+		{name: "actual pilot model effort and service config", extra: []string{"-c", `model_reasoning_effort="xhigh"`}},
+		{name: "managed listen is removed", custom: []string{"--listen", "tcp://127.0.0.1:1", "--enable", "fast_mode"}},
+		{name: "legacy policy flags are SDK managed", extra: []string{"--dangerously-bypass-approvals-and-sandbox", "--full-auto"}},
+		{name: "exec subcommand is rejected", custom: []string{"exec"}, invalid: true},
+		{name: "resume subcommand is rejected", custom: []string{"resume", "legacy-id"}, invalid: true},
+		{name: "exec output flag is rejected", custom: []string{"--output-last-message", "answer.txt"}, invalid: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			// Missing executable and private profile guarantee this regression can
+			// exercise the real SDK validator without calling any user CLI/model.
+			base := t.TempDir()
+			b := newAdaptorBackend(Config{ExecutablePath: filepath.Join(base, "no-agent-executable"), Env: map[string]string{"CODEX_HOME": filepath.Join(base, "codex")}, Logger: slog.New(slog.NewTextHandler(io.Discard, nil))})
+			cfg := b.codexConfig(ExecOptions{Model: "gpt-6.1-sol", ThinkingLevel: "xhigh", ServiceTier: "default", ExtraArgs: test.extra, CustomArgs: test.custom})
+			d := sdkcodex.Driver(cfg)
+			if err := d.ValidateConfig(nil); err != nil {
+				t.Fatalf("captured real driver config validation: %v", err)
+			}
+			policy := adaptor.Policy{Approvals: adaptor.ApprovalPolicy{Permission: adaptor.ApprovalAutoApprove}}
+			policy.Messages.Disabled = true
+			a := adaptor.New(d, adaptor.WithWorkspace(base), adaptor.WithPolicy(policy))
+			ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+			defer cancel()
+			s := a.Send(ctx, "must never reach a provider")
+			_, err := s.Result()
+			var invalid *driver.InvalidDriverConfigError
+			if errors.As(err, &invalid) != test.invalid {
+				t.Fatalf("real app-server validation invalid=%v, error=%v", test.invalid, err)
+			}
+			if err == nil {
+				t.Fatal("missing executable unexpectedly ran")
+			}
+			if err := a.Close(ctx); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
