+func TestAdaptorShadowResumeAndConfigurationDrift(t *testing.T) {
+	var runs atomic.Int32
+	b := shadowBackend(t, func(_ context.Context, r driver.Request, _ driver.EventSink) (driver.Response, error) {
+		if runs.Add(1) == 2 && (r.Session == nil || r.Session.State == nil || r.Session.State.ResumeID != "healthy-session") {
+			t.Error("healthy SDK checkpoint was not resumed")
+		}
+		response := shadowCheckpoint(r)
+		if runs.Load() == 3 {
+			if r.Session != nil && r.Session.State != nil && r.Session.State.ResumeID != "" {
+				t.Error("configuration drift reused an incompatible provider checkpoint")
+			}
+			if !strings.Contains(r.Prompt, "done") || !strings.Contains(r.Prompt, "drift") {
+				t.Errorf("bounded continuity/current prompt missing: %q", r.Prompt)
+			}
+			response.Checkpoint.State.ResumeID = "replacement-session"
+		}
+		return response, nil
+	})
+	opts := ExecOptions{Cwd: t.TempDir(), Model: "same"}
+	for n := 0; n < 2; n++ {
+		b.cfg.TaskID = fmt.Sprintf("task-%d", n)
+		s, err := b.Execute(context.Background(), "continue", opts)
+		if err != nil {
+			t.Fatal(err)
+		}
+		got := awaitShadow(t, drainShadow(s))
+		if got.Status != "completed" || got.SessionID != "healthy-session" {
+			t.Fatalf("run %d=%+v", n, got)
+		}
+		opts.ResumeSessionID = got.SessionID
+	}
+	opts.Model = "changed"
+	b.cfg.TaskID = "task-drift"
+	s, err := b.Execute(context.Background(), "drift", opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	visibleNotice := false
+	for message := range s.Messages {
+		visibleNotice = visibleNotice || (message.Type == MessageText && strings.Contains(message.Content, "[Host continuity warning]"))
+	}
+	if got := awaitShadow(t, s.Result); got.Status != "completed" || got.SessionID != "replacement-session" {
+		t.Fatalf("disclosed fresh fallback=%+v", got)
+	}
+	if runs.Load() != 3 || !visibleNotice {
+		t.Fatalf("fresh fallback runs=%d visible notice=%v", runs.Load(), visibleNotice)
+	}
