+func TestAdaptorShadowReadinessRequiresInspectedCapabilityAndOfficialTurn(t *testing.T) {
+	bridge := &adaptorSession{canSupplement: true, logger: slog.New(slog.NewTextHandler(io.Discard, nil))}
+	// No code path below can call the stream: these are only provider lifecycle
+	// announcements, not delivery or a completed execution.
+	emit := func(message Message) {
+		if message.SessionID != "" {
+			t.Error("provider announcement was exposed as a healthy checkpoint")
+		}
+	}
+	bridge.observe(adaptor.RunStarted{ThreadID: "announced-only"}, emit)
+	if bridge.ready.Load() {
+		t.Fatal("provider thread announcement opened the durable claim gate")
+	}
+	bridge.canSupplement = false
+	bridge.observe(adaptor.WithEventMeta(adaptor.RunStarted{ThreadID: "thread"}, adaptor.EventMeta{TurnID: "turn"}), emit)
+	if bridge.ready.Load() {
+		t.Fatal("unavailable inspected message capability opened the claim gate")
+	}
+	bridge.canSupplement = true
+	// A stream is needed solely to identify the log entry for this actual turn.
+	bridge.stream = &shadowReadinessStream{}
+	bridge.observe(adaptor.WithEventMeta(adaptor.RunStarted{ThreadID: "thread"}, adaptor.EventMeta{Source: &adaptor.EventSourceMeta{TurnID: "official-turn"}}), emit)
+	if !bridge.ready.Load() {
+		t.Fatal("confirmed provider turn did not open negotiated delivery")
+	}
+	bridge.observe(adaptor.RunFinished{}, emit)
+	if bridge.ready.Load() || bridge.terminal.Load() {
+		t.Fatal("provider turn end was treated as SDK cleanup completion")
+	}
+}
+
+type shadowReadinessStream struct{ adaptor.Stream }
+
+func (*shadowReadinessStream) RunID() string { return "readiness-log-run" }
+
+type shadowCleanupDriver struct{ *shadowTestDriver }
+
+func (d shadowCleanupDriver) Descriptor() driver.Descriptor {
+	v := d.shadowTestDriver.Descriptor()
+	v.Process.Persistent = true
+	return v
+}
+func (shadowCleanupDriver) CloseProcesses(context.Context) error {
+	return errors.New("offline cleanup could not be confirmed")
+}
