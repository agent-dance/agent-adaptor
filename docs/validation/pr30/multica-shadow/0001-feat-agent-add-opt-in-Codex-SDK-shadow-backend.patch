+	// The SDK owns the shadow invocation's bounded resume fallback and message
+	// receipts. A daemon retry would open a second execution of the same input.
+	return !isCodexAdaptorShadow(provider, codexBackend) && shouldRetryWithFreshSession(result, priorSessionID, tools, provider)
