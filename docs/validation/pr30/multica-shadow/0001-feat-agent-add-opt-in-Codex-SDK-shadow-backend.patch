+func TestAdaptorShadowAdmissionIsNotDelivery(t *testing.T) {
+	for _, delivered := range []bool{true, false} {
+		t.Run(map[bool]string{true: "delivered", false: "failed"}[delivered], func(t *testing.T) {
+			claimed := make(chan driver.MessageItem, 1)
+			ack := make(chan struct{})
+			started := make(chan struct{})
+			b := shadowBackend(t, func(ctx context.Context, r driver.Request, s driver.EventSink) (driver.Response, error) {
+				if err := s.EmitStream(driver.StreamPayload{Kind: driver.StreamRunStarted, ThreadID: "healthy-session", TurnID: "official-turn"}); err != nil {
+					return driver.Response{}, err
+				}
+				r.Messages.Window(true)
+				close(started)
+				select {
+				case <-r.Messages.Signal():
+				case <-ctx.Done():
+					return driver.Response{}, ctx.Err()
+				}
+				items := r.Messages.Claim(driver.BoundaryImmediate)
+				if len(items) != 1 {
+					return driver.Response{}, errors.New("missing claimed supplement")
+				}
+				claimed <- items[0]
+				select {
+				case <-ack:
+				case <-ctx.Done():
+					return driver.Response{}, ctx.Err()
+				}
+				r.Messages.Ack(items[0].ID, driver.MessageAck{Delivered: delivered, Err: errors.New("official rejection"), Mechanism: "offline.provider_ack"})
+				return shadowCheckpoint(r), nil
+			})
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			s, err := b.Execute(ctx, "objective", ExecOptions{Cwd: t.TempDir(), EnableTaskSupplement: true})
+			if err != nil {
+				t.Fatal(err)
+			}
+			result := drainShadow(s)
+			awaitShadow(t, started)
+			completed := make(chan error, 1)
+			go func() {
+				completed <- s.SupplementInput(ctx, SupplementInput{ID: "原评论/1", Text: "raw @agent 😀", AuthorType: "agent", AuthorID: "actor-1", AuthorName: "other agent"})
+			}()
+			item := awaitShadow(t, claimed)
+			if item.ID != "原评论/1" || !strings.Contains(item.Text, "raw @agent 😀") || !strings.Contains(item.Text, "other agent") || !strings.Contains(item.Text, "not a human instruction") {
+				t.Fatalf("lost identity or framing: %+v", item)
+			}
+			select {
+			case err := <-completed:
+				t.Fatalf("admission falsely acknowledged: %v", err)
+			default:
+			}
+			close(ack)
+			err = awaitShadow(t, completed)
+			if delivered && err != nil {
+				t.Fatal(err)
+			}
+			if !delivered {
+				var failure *AdaptorSupplementError
+				if !errors.As(err, &failure) || failure.Reason != "provider_rejected" {
+					t.Fatalf("receipt=%v", err)
+				}
+			}
+			if got := awaitShadow(t, result); got.Status != "completed" {
+				t.Fatalf("result=%+v", got)
+			}
+		})
+	}
+}
