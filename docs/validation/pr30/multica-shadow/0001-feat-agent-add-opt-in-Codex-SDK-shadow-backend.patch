+// The tuple preserves the host conversation across task IDs without turning a
+// provider resume handle into the SDK's business identity. Standalone tasks
+// have no conversation to share and therefore include their own task ID.
+func adaptorThreadKey(task Task) string {
+	standalone := ""
+	if task.IssueID == "" && task.ChatSessionID == "" {
+		standalone = task.ID
+	}
+	encoded, _ := json.Marshal([]string{
+		task.WorkspaceID, task.RuntimeID, task.AgentID,
+		task.IssueID, task.ChatSessionID, standalone,
+	})
