+// the original ID that the backend must validate, or asserting a known loss.
+func taskForBackendPrompt(task Task, provider, codexBackend string) Task {
+	if isCodexAdaptorShadow(provider, codexBackend) {
+		task.PriorSessionID = ""
+	}
+	return task
+}
