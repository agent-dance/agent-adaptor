+package daemon
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/multica-ai/multica/server/pkg/agent"
+)
+
+func TestCodexBackendSelectionRequiresExplicitOptIn(t *testing.T) {
+	for _, test := range []struct {
+		input string
+		want  string
+	}{
+		{"", "native"},
+		{"native", "native"},
+		{"agent-adaptor", "agent-adaptor"},
+		{" agent-adaptor \n", "agent-adaptor"},
+	} {
+		t.Run(test.input, func(t *testing.T) {
+			got, err := parseCodexBackend(test.input)
+			if err != nil || got != test.want {
+				t.Fatalf("backend %q = %q, %v; want %q", test.input, got, err, test.want)
+			}
+		})
+	}
+	for _, input := range []string{"adaptor", "Agent-Adaptor", "agent-adaptor,codex", "true"} {
+		if _, err := parseCodexBackend(input); err == nil {
+			t.Fatalf("unknown backend %q was accepted", input)
+		}
+	}
+}
+
+func TestLoadConfigRejectsUnknownCodexBackendBeforeAnyProbes(t *testing.T) {
+	t.Setenv("MULTICA_CODEX_BACKEND", "not-a-backend")
+	_, err := LoadConfig(Overrides{ServerURL: "://invalid"})
+	if err == nil || !strings.Contains(err.Error(), "MULTICA_CODEX_BACKEND") {
+		t.Fatalf("invalid selector was not rejected at configuration entry: %v", err)
+	}
+}
+
+func TestLoadConfigCarriesCodexBackendSelection(t *testing.T) {
+	stageFakeAgent(t)
+	redirectTestHome(t, t.TempDir())
+	for _, pair := range os.Environ() {
+		key, _, _ := strings.Cut(pair, "=")
+		if strings.HasPrefix(key, "MULTICA_") && strings.HasSuffix(key, "_PATH") {
+			t.Setenv(key, "")
+		}
+	}
+	t.Setenv("SHELL", filepath.Join(t.TempDir(), "missing-shell"))
+	for _, test := range []struct{ env, want string }{{"", "native"}, {"agent-adaptor", "agent-adaptor"}} {
+		t.Run(test.want, func(t *testing.T) {
+			t.Setenv("MULTICA_CODEX_BACKEND", test.env)
+			cfg, err := LoadConfig(Overrides{ServerURL: "http://localhost:0", WorkspacesRoot: t.TempDir()})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if cfg.CodexBackend != test.want {
+				t.Fatalf("CodexBackend = %q, want %q", cfg.CodexBackend, test.want)
+			}
+		})
+	}
+}
+
+func TestAdaptorThreadKeyTracksBusinessConversation(t *testing.T) {
+	issue := Task{ID: "task-1", WorkspaceID: "workspace", RuntimeID: "runtime", AgentID: "agent", IssueID: "issue"}
+	next := issue
+	next.ID, next.PriorSessionID = "task-2", "different-provider-session"
+	if adaptorThreadKey(issue) != adaptorThreadKey(next) {
+		t.Fatal("task or provider session changed a stable issue conversation key")
+	}
+	chat := issue
+	chat.IssueID, chat.ChatSessionID = "", "chat"
+	nextChat := chat
+	nextChat.ID = "another-task"
+	if adaptorThreadKey(chat) != adaptorThreadKey(nextChat) {
+		t.Fatal("task ID changed a stable chat conversation key")
+	}
+	for _, mutate := range []func(*Task){
+		func(task *Task) { task.WorkspaceID = "other-workspace" },
+		func(task *Task) { task.RuntimeID = "other-runtime" },
+		func(task *Task) { task.AgentID = "other-agent" },
+		func(task *Task) { task.IssueID = "other-issue" },
+		func(task *Task) { task.IssueID, task.ChatSessionID = "", "issue" },
+	} {
+		other := issue
+		mutate(&other)
+		if adaptorThreadKey(other) == adaptorThreadKey(issue) {
+			t.Fatalf("different host conversation collided: %+v", other)
+		}
+	}
+	standalone := Task{ID: "task-1", WorkspaceID: "workspace", RuntimeID: "runtime", AgentID: "agent"}
+	other := standalone
+	other.ID = "task-2"
+	if adaptorThreadKey(standalone) == adaptorThreadKey(other) {
+		t.Fatal("unrelated standalone tasks shared a conversation")
+	}
+}
+
+func TestAdaptorThreadKeyDoesNotCollideAtSeparatorsOrUnicode(t *testing.T) {
+	seen := map[string]Task{}
+	for _, task := range []Task{
+		{WorkspaceID: "a/b", RuntimeID: "c", AgentID: "agent", IssueID: "issue"},
+		{WorkspaceID: "a", RuntimeID: "b/c", AgentID: "agent", IssueID: "issue"},
+		{WorkspaceID: "a:b", RuntimeID: "c", AgentID: "agent", IssueID: "issue"},
+		{WorkspaceID: "a", RuntimeID: "b:c", AgentID: "agent", IssueID: "issue"},
+		{WorkspaceID: "工作区\x00", RuntimeID: "运行时", AgentID: "智能体", IssueID: "议题"},
+		{WorkspaceID: "工作区", RuntimeID: "\x00运行时", AgentID: "智能体", IssueID: "议题"},
+		{WorkspaceID: `a\"b`, RuntimeID: "c", AgentID: "agent", IssueID: "issue"},
+		{WorkspaceID: "a", RuntimeID: `\"bc`, AgentID: "agent", IssueID: "issue"},
+	} {
+		key := adaptorThreadKey(task)
+		if previous, ok := seen[key]; ok {
+			t.Fatalf("host tuples collided: %+v and %+v", previous, task)
+		}
+		seen[key] = task
+	}
+}
+
+func TestAdaptorShadowDoesNotRetryTheSDKInvocation(t *testing.T) {
+	for _, test := range []struct {
+		name   string
+		result agent.Result
+	}{
+		{"resume rejected", agent.Result{Status: "failed", ResumeRejected: true}},
+		{"resume temporarily rejected", agent.Result{Status: "failed", ResumeRejectedTransient: true}},
+		{"invalid history", agent.Result{Status: "failed", Error: "invalid conversation history received"}},
+		{"empty history message", agent.Result{Status: "failed", Error: "messages.3.content must not be empty"}},
+		{"unresolved auth", agent.Result{Status: "failed", Error: "Could not resolve authentication method"}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			if shouldRetryBackendWithFreshSession(test.result, "prior-session", 0, "codex", "agent-adaptor") {
+				t.Fatal("daemon would execute a second shadow invocation after the SDK settled it")
+			}
+			for _, native := range []struct{ provider, backend string }{
+				{"codex", ""}, {"codex", "native"}, {"claude", "agent-adaptor"},
+			} {
+				if !shouldRetryBackendWithFreshSession(test.result, "prior-session", 0, native.provider, native.backend) {
+					t.Fatalf("native retry changed for provider=%q backend=%q", native.provider, native.backend)
+				}
+				if shouldRetryBackendWithFreshSession(test.result, "prior-session", 1, native.provider, native.backend) {
+					t.Fatal("native retry ignored a tool side effect")
+				}
+				if shouldRetryBackendWithFreshSession(test.result, "", 0, native.provider, native.backend) {
+					t.Fatal("native cold invocation acquired a resume retry")
+				}
+			}
+		})
+	}
+}
+
+func TestAdaptorShadowPromptReconstructsWithoutDiscardingTheRealResumeID(t *testing.T) {
+	task := Task{
+		ID: "task", WorkspaceID: "workspace", RuntimeID: "runtime", AgentID: "agent",
+		IssueID: "issue", TriggerCommentID: "comment", TriggerThreadID: "thread",
+		TriggerCommentContent: "Please inspect the new candidate.",
+		PriorSessionID:        "healthy-or-unsupported-legacy-id", NewCommentsDeltaKnown: true,
+		IssueStateDeltaKnown: true,
+	}
+	semanticTask := taskForBackendPrompt(task, "codex", "agent-adaptor")
+	if semanticTask.PriorSessionID != "" {
+		t.Fatal("shadow prompt still assumes provider memory will be resumed")
+	}
+	if task.PriorSessionID != "healthy-or-unsupported-legacy-id" {
+		t.Fatal("prompt projection discarded the original ID needed by SDK resume validation")
+	}
+	if semanticTask.PriorSessionResumeUnavailable || task.PriorSessionResumeUnavailable {
+		t.Fatal("unknown resume outcome was reported as a known continuity loss")
+	}
+	if adaptorThreadKey(semanticTask) != adaptorThreadKey(task) {
+		t.Fatal("prompt projection changed the SDK business thread identity")
+	}
+	prompt := BuildPrompt(semanticTask, "codex")
+	for _, want := range []string{
+		"multica issue get issue --output json",
+		"multica issue comment list issue --thread thread --tail 30",
+		"--roots-only --summary",
+		task.TriggerCommentContent,
+	} {
+		if !strings.Contains(prompt, want) {
+			t.Fatalf("cold shadow prompt lost %q:\n%s", want, prompt)
+		}
+	}
+	for _, forbidden := range []string{"You're resuming the prior session", "this turn's issue-wide delta is empty", "Session Continuity Notice"} {
+		if strings.Contains(prompt, forbidden) {
+			t.Fatalf("shadow prompt asserted unobserved continuity %q:\n%s", forbidden, prompt)
+		}
+	}
+	for _, native := range []struct{ provider, backend string }{
+		{"codex", ""}, {"codex", "native"}, {"claude", "agent-adaptor"},
+	} {
+		nativeTask := taskForBackendPrompt(task, native.provider, native.backend)
+		if nativeTask.PriorSessionID != task.PriorSessionID || BuildPrompt(nativeTask, native.provider) != BuildPrompt(task, native.provider) {
+			t.Fatalf("native prompt changed for provider=%q backend=%q", native.provider, native.backend)
+		}
+	}
+	if !strings.Contains(BuildPrompt(task, "codex"), "You're resuming the prior session") {
+		t.Fatal("fixture did not exercise the warm native branch")
+	}
+
+	task.ChatSessionID, task.ChatMessage = "chat", "Explain the latest candidate."
+	chatPrompt := BuildPrompt(taskForBackendPrompt(task, "codex", "agent-adaptor"), "codex")
+	if !strings.Contains(chatPrompt, task.ChatMessage) || strings.Contains(chatPrompt, "Session Continuity Notice") {
+		t.Fatalf("chat projection lost the message or fabricated a loss:\n%s", chatPrompt)
+	}
+	task.PriorSessionResumeUnavailable = true
+	if !taskForBackendPrompt(task, "codex", "agent-adaptor").PriorSessionResumeUnavailable {
+		t.Fatal("prompt projection hid a continuity loss already reported by the server")
+	}
+}
+
+func TestAdaptorShadowCheckpointSkipsNativeRolloutProbe(t *testing.T) {
+	probes := 0
+	probe := func() bool {
+		probes++
+		return false
+	}
+	if shouldWithholdMissingNativeRollout("codex", "agent-adaptor", "sdk-healthy-session", probe) {
+		t.Fatal("native rollout lookup overruled a healthy SDK checkpoint")
+	}
+	if probes != 0 {
+		t.Fatal("shadow execution probed the unrelated native rollout store")
+	}
+	if shouldWithholdMissingNativeRollout("codex", "native", "", probe) || probes != 0 {
+		t.Fatal("a result without a session ID triggered a native rollout probe")
+	}
+}
+
+func TestAdaptorNativeMissingRolloutStillWithholdsSession(t *testing.T) {
+	home := t.TempDir()
+	for _, backend := range []string{"", "native"} {
+		probes := 0
+		if !shouldWithholdMissingNativeRollout("codex", backend, "missing-native-session", func() bool {
+			probes++
+			return codexSessionResumable(home, "missing-native-session", 0)
+		}) {
+			t.Fatalf("native backend %q retained a session whose rollout is missing", backend)
+		}
+		if probes != 1 {
+			t.Fatalf("native probes = %d, want 1", probes)
+		}
+	}
+	for _, native := range []struct{ provider, backend string }{
+		{"codex", "native"}, {"claude", "agent-adaptor"},
+	} {
+		probes := 0
+		if shouldWithholdMissingNativeRollout(native.provider, native.backend, "healthy-session", func() bool {
+			probes++
+			return true
+		}) || probes != 1 {
+			t.Fatalf("healthy native checkpoint handling changed for provider=%q backend=%q", native.provider, native.backend)
+		}
+	}
+}
