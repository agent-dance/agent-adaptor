+func TestAdaptorShadowCleanupFailurePreventsContinuation(t *testing.T) {
+	b := shadowBackend(t, func(_ context.Context, r driver.Request, _ driver.EventSink) (driver.Response, error) {
+		return shadowCheckpoint(r), nil
+	})
+	factory := b.newDriver
+	b.newDriver = func(cfg sdkcodex.Config) driver.Driver { return shadowCleanupDriver{factory(cfg).(*shadowTestDriver)} }
+	opts := ExecOptions{Cwd: t.TempDir()}
+	s, err := b.Execute(t.Context(), "work", opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := awaitShadow(t, drainShadow(s))
+	if got.Status != "cleanup_unconfirmed" {
+		t.Fatalf("cleanup failure was hidden: %+v", got)
+	}
+	opts.ResumeSessionID = got.SessionID
+	if _, err = b.Execute(t.Context(), "continue", opts); err == nil || !strings.Contains(err.Error(), "cleanup is unconfirmed") {
+		t.Fatalf("unsafe continuation=%v", err)
+	}
+}
