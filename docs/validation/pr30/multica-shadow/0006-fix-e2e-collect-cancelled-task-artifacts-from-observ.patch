   const entry: Record<string, unknown> = {};
   const fields = /(?:^|\s)([A-Za-z_][A-Za-z0-9_]*)=("(?:\\.|[^"\\])*"|[^\s"]+)(?=\s|$)/g;
   for (const match of line.matchAll(fields)) {
@@ -135,6 +135,21 @@ function logRecord(line: string): Record<string, unknown> | undefined {
   return entry;
 }
 
+export function cancelledTaskWorkspace(log: string, taskID: string): { path: string; line: string } {
+  if (!taskID) throw new Error("Cancelled task ID is required");
+  const matches = log.split(/\r?\n/).flatMap((line) => {
+    const entry = logRecord(line);
+    return entry?.msg === "starting agent" && entry.component === "daemon" && entry.task === taskID ? [{ entry, line }] : [];
+  });
+  if (matches.length !== 1) throw new Error(`Cancelled task ${taskID} needs exactly one formal daemon startup workspace`);
+  const match = matches[0]!;
+  const path = match.entry.workdir;
+  if (typeof path !== "string" || !path.startsWith("/") || path.startsWith("//") || path.includes("\0") || path.split("/").some((part) => part === ".." || part === ".")) {
+    throw new Error(`Cancelled task ${taskID} has no absolute host-observed workspace`);
+  }
+  return { path, line: match.line };
+}
+
 function hasRunIdentity(entry: Record<string, unknown>): entry is Record<string, unknown> & { task_id: string; run_id: string } {
   return typeof entry.task_id === "string" && entry.task_id.trim() !== "" &&
     typeof entry.run_id === "string" && entry.run_id.trim() !== "";
diff --git a/e2e/agent-adaptor-shadow.md b/e2e/agent-adaptor-shadow.md
index 41d4249cf..114cd40b1 100644
--- a/e2e/agent-adaptor-shadow.md
+++ b/e2e/agent-adaptor-shadow.md
@@ -68,6 +68,8 @@ Each case writes `actual-shadow-evidence.json` and screenshots in Playwright's o
 
 The aggregate report requires one native case or all four shadow cases before `complete=true`; `passed=true` also requires every case to pass. It survives Playwright worker replacement, rejects duplicate cases or another run's report, and never converts partial evidence to success. Preserve both phase reports, Playwright output, and the original daemon logs. Do not claim UI acceptance from API records alone: the real browser cases and screenshots must pass.
 
+For a cancelled task whose API result omits the workspace, artifact collection uses only the unique formal daemon `starting agent` record for that exact task after the case's log offset. The receipt retains the original line and absolute path. Missing or ambiguous records fail; no path is guessed from a new task or directory naming conventions. Successful tasks still require their normal API workspace.
+
 This suite validates the selected structured mention and ordinary-reply routes, not Multica's entire mention parser. Chat Steer is the product's cancel-and-prioritize flow, not SDK `Interrupt`; **Start after this run** is a new execution after Done, not SDK `AfterTurn`. It does not prove legacy provider-session import, durable daemon restart recovery, all plugins, or deployment behavior.
 
 The mapped behavior comes from the official Multica checkout at `0d627e54e1bd4d2521359f293d04521246495ce2`: `apps/docs/content/docs/mentioning-agents.mdx` (explicit targets, plain replies, four delivery choices), `apps/docs/content/docs/chat.mdx` (FIFO/Steer), and the actual comment/chat handlers and UI in this checkout.
