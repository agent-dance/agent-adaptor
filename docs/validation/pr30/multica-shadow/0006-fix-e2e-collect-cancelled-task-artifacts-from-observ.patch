 });
 
+test("cancelled workspace comes from the unique exact-task formal daemon startup", () => {
+  const fields = { component: "daemon", task: "old-task", workdir: "/tmp/isolated/old-task/workdir" };
+  for (const line of [
+    JSON.stringify({ msg: "starting agent", ...fields }),
+    'msg="starting agent" component=daemon task=old-task workdir=/tmp/isolated/old-task/workdir',
+    '02:38:29.723 INF starting agent component=daemon task=old-task provider=codex workdir=/tmp/isolated/old-task/workdir model=gpt-6.1-sol resume_reachable=false',
+  ]) {
+    expect(cancelledTaskWorkspace(line, "old-task")).toEqual({ path: fields.workdir, line });
+    expect(() => cancelledTaskWorkspace(line, "new-task")).toThrow();
+    expect(() => cancelledTaskWorkspace(line + "\n" + line, "old-task")).toThrow();
+  }
+});
+
+test("missing, guessed, foreign, relative, or ambiguous cancelled workspaces fail", () => {
+  const line = '02:38:29.723 INF starting agent component=daemon task=old-task workdir=/tmp/isolated/old-task/workdir';
+  for (const log of ["", line.replace("old-task workdir", "new-task workdir"), line.replace("component=daemon", "component=model"), line.replace("starting agent", "agent output starting agent"), line.replace("workdir=/tmp/isolated/old-task/workdir", ""), ...["relative/workdir", "", "/tmp/../other", "/tmp/./old-task", "//other/workdir", "/tmp/\0bad"].map((workdir) => JSON.stringify({ msg: "starting agent", component: "daemon", task: "old-task", workdir })), line + ' task=foreign', line + '\n' + line.replace('workdir=/tmp/isolated/old-task/workdir', 'workdir=/tmp/other')]) {
+    expect(() => cancelledTaskWorkspace(log, "old-task")).toThrow();
+  }
+  expect(() => cancelledTaskWorkspace(line, "")).toThrow();
+});
+
 test("delivery evidence is the sole exact task and agent receipt", () => {
   const delivered = receipt();
   expect(deliveredReceipt({ supplements: [delivered] }, "task-1", "agent-1")).toBe(delivered);
