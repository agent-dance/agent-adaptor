   // Multica's configured tint handler puts the formal message before its attrs.
-  const tint = line.match(/^(?:[01]\d|2[0-3]):[0-5]\d:[0-5]\d\.\d{3}\s+(?:DBG|INF|WRN|ERR)\s+(agent-adaptor shadow execution (?:started|finished))(?=\s+[A-Za-z_][A-Za-z0-9_]*=)/);
