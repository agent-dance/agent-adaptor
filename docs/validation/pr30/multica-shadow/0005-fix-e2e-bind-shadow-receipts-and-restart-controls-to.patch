--- /dev/null
+++ b/e2e/agent-adaptor-shadow.browser.ts
@@ -0,0 +1,12 @@
+import type { Page } from "@playwright/test";
+
+export type ReplyAction = "Add to current run" | "Start after this run" | "Stop and start over";
+export const browserTimeout = 45_000;
+
+export async function submitReply(page: Page, issueID: string, action: ReplyAction, timeout = browserTimeout) {
+  const [response] = await Promise.all([
+    page.waitForResponse((response) => response.request().method() === "POST" && new URL(response.url()).pathname === `/api/issues/${issueID}/comments`, { timeout }),
+    page.getByRole("button", { name: action === "Stop and start over" ? "Stop and send" : "Send", exact: true }).first().click({ timeout }),
+  ]);
+  return response;
+}
