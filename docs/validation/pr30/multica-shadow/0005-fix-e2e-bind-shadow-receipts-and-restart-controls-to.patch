   return receipt;
 }
 
+export async function readDeliveredComment(request: (path: string) => Promise<unknown>, issueID: string, commentID: string, taskID: string, agentID: string): Promise<Record<string, unknown>> {
+  // The UI timeline hydrates receipts; the flat comments endpoint does not.
+  const timeline = await request(`/api/issues/${issueID}/timeline`);
+  if (!Array.isArray(timeline)) throw new Error("Timeline must be an array");
+  const matches = timeline.filter((entry) => isRecord(entry) && entry.type === "comment" && entry.id === commentID);
+  if (matches.length !== 1) throw new Error(`Timeline must contain exactly one comment ${commentID}`);
+  const comment = matches[0] as Record<string, unknown>;
+  deliveredReceipt(comment, taskID, agentID);
+  return comment;
+}
+
