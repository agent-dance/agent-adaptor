+import { expect, test } from "@playwright/test";
+import { browserTimeout, submitReply, type ReplyAction } from "./agent-adaptor-shadow.browser";
+
+test("reply submission selects the formal restart button despite another disabled Send", async ({ page }) => {
+  await page.route("http://127.0.0.1/api/issues/fixture/comments", (route) => route.fulfill({ status: 201, contentType: "application/json", body: '{"id":"created-comment"}', headers: { "Access-Control-Allow-Origin": "*" } }));
+  await page.setContent(`<button disabled>Send</button><button onclick="fetch('http://127.0.0.1/api/issues/fixture/comments',{method:'POST'})">Stop and send</button>`);
+  const response = await submitReply(page, "fixture", "Stop and start over", 2_000);
+  expect(response.status()).toBe(201);
+  expect(await response.json()).toEqual({ id: "created-comment" });
+});
+
+for (const action of ["Add to current run", "Start after this run"] satisfies ReplyAction[]) {
+  test(`ordinary ${action} uses Send and the exact issue endpoint`, async ({ page }) => {
+    await page.route("http://127.0.0.1/api/issues/fixture/comments", (route) => route.fulfill({ status: 201, headers: { "Access-Control-Allow-Origin": "*" } }));
+    await page.setContent(`<button onclick="fetch('http://127.0.0.1/api/issues/fixture/comments',{method:'POST'})">Send</button><button disabled>Stop and send</button>`);
+    expect((await submitReply(page, "fixture", action, 2_000)).status()).toBe(201);
+  });
+}
+
+test("missing enabled submission fails within its action and response deadline", async ({ page }) => {
+  expect(browserTimeout).toBe(45_000);
+  await page.setContent("<button disabled>Stop and send</button>");
+  const started = Date.now();
+  await expect(submitReply(page, "fixture", "Stop and start over", 100)).rejects.toThrow(/Timeout/);
+  expect(Date.now() - started).toBeLessThan(2_000);
+});
