    "test:offline": "node --test test/offline.test.mjs"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.3",
    "@assistant-ui/react": "0.15.32",
    "@assistant-ui/react-ag-ui": "0.1.1",
    "@assistant-ui/react-markdown": "0.14.24",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "ajv": "8.20.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "zod": "4.6.7"
  }
