{
  "name": "agent-adaptor-web-chat-assistant-ui",
  "version": "0.1.0",
  "private": true,
  "description": "assistant-ui + @ag-ui/client HttpAgent talking directly to the agent-adaptor recorded AG-UI session.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
