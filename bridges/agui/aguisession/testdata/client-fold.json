    "expected": [
      {
        "id": "a",
        "role": "assistant",
        "content": "hi",
        "name": "helper",
        "subagentRunId": "child",
        "metadata": {
          "ns": {
            "new": 2
          },
          "keep": true,
          "done": true
        }
      }
    ]
  },
