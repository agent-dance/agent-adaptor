        "name": "helper",
        "subagentRunId": "child",
        "metadata": {
          "ns": {
            "old": 1
          },
          "keep": true
        }
      },
      {
        "type": "TEXT_MESSAGE_CONTENT",
        "messageId": "a",
        "delta": "hi",
        "metadata": {
          "ns": {
            "new": 2
